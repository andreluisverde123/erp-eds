# POC — Distribuição DF-e. Copie para `.env` e preencha.
# O `.env` real está no .gitignore: ele contém a senha do certificado.

# `producao` ou `homologacao`.
# ATENÇÃO: homologação NÃO devolve os documentos reais da empresa — a base dela
# é vazia. A validação de que "as notas da EDS chegam" só acontece em produção.
# Consultar produção é somente leitura: não emite nem altera nada.
NFE_AMBIENTE=producao

# UF do autor da consulta (só afeta roteamento interno da SEFAZ).
NFE_UF=SP

# Certificado A1 (.pfx / .p12). A3 (token/cartão) NÃO serve: a chave não é
# exportável e não há como um serviço não interativo usá-la.
NFE_PFX_PATH=certs/certificado.pfx
NFE_PFX_PASSWORD=

# Opcional: quando vazio, é extraído do próprio certificado.
# Precisa ser o CNPJ do TITULAR — a SEFAZ só devolve documentos de quem se
# autenticou.
NFE_CNPJ=

# Último NSU processado. 0 começa do início da base.
# Depois da primeira execução, use o `ultNSU` que a POC gravou em out/_cursor.json.
NFE_ULT_NSU=0

# Só para depuração de TLS. Deixe comentado.
# Desliga a verificação do certificado DO SERVIDOR (não do nosso).
# NFE_INSEGURO=true

# Alternativa correta ao acima, se algum dia a cadeia do servidor não validar:
# um PEM com as raízes. Hoje NÃO é necessário — ver README.
# NFE_CA_PATH=certs/cadeia.pem
