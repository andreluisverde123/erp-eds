# Endereço da API. Caminho relativo ("/api") quando front e API são servidos
# pela mesma origem (nginx do docker/docker-compose.prod.yml); URL absoluta em
# desenvolvimento, onde o Vite e a API rodam em portas diferentes.
VITE_API_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Identidade do PRODUTO
#
# A mesma base origina dois produtos. O que os diferencia visualmente são as
# três variáveis abaixo — nenhum componente precisa ser editado.
#
# Plataforma SaaS (multi-inquilino): a marca do topo é a do produto, e o
# rodapé da barra lateral diz de qual construtora é a sessão.
#
#   VITE_PRODUCT_NAME="OManager"
#   VITE_PRODUCT_LOGO="/logo-product.svg"
#   VITE_SHOW_TENANT_BADGE="true"
#
# Instalação dedicada a um cliente: o logo do sistema JÁ é o do cliente, então
# o cartão do rodapé vira repetição e sai.
#
#   VITE_PRODUCT_NAME="EDS"
#   VITE_PRODUCT_LOGO="/logo-eds.svg"
#   VITE_SHOW_TENANT_BADGE="false"
#
# A marca do INQUILINO (nome e logo da construtora) continua vindo do banco a
# cada login nos dois casos, e não se configura aqui.
# ---------------------------------------------------------------------------
VITE_PRODUCT_NAME="OManager"
VITE_PRODUCT_LOGO="/logo-product.svg"
VITE_SHOW_TENANT_BADGE="true"
