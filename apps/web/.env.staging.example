# =============================================================================
# STAGING — WEB
# =============================================================================
# Copie para `.env.staging` (gitignorado):
#
#   cp apps/web/.env.staging.example apps/web/.env.staging
#
# Carregado automaticamente pelo Vite com `vite build --mode staging`
# (npm run build:staging). O Vite lê `.env`, `.env.local`, `.env.<mode>` e
# `.env.<mode>.local`, nesta ordem de precedência crescente — e só expõe ao
# bundle o que começa com `VITE_`.
#
# ATENÇÃO: estas variáveis são resolvidas em tempo de BUILD e ficam CRAVADAS no
# bundle. Trocá-las exige rebuild; defini-las no `docker run` não tem efeito.
# Por isso cada ambiente precisa da própria imagem — a menos que se use caminho
# relativo, como abaixo.
# =============================================================================

# Caminho RELATIVO de propósito: com o nginx servindo o SPA e repassando /api
# (origem única), nenhuma URL absoluta entra no bundle e a MESMA imagem roda em
# qualquer domínio. Só use URL absoluta se a API ficar em outro host — e aí
# lembre que o cookie de refresh é SameSite=Lax e pode não ser enviado.
VITE_API_URL="/api"

# Auto-cadastro de construtora (rota /cadastro). Desligado: o primeiro acesso
# vem do bootstrap do seed. Ligar aqui sem ligar PUBLIC_SIGNUP_ENABLED na API
# não adianta — a tela abre e o endpoint recusa.
VITE_PUBLIC_SIGNUP_ENABLED="false"
