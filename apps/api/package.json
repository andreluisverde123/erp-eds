{
  "name": "api",
  "version": "0.1.0",
  "description": "API NestJS do ERP EDS",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "build:staging": "nest build",
    "build:production": "nest build",
    "start:local": "node --env-file=.env.local dist/main",
    "start:development": "node --env-file=.env.development dist/main",
    "start:staging": "node --env-file=.env.staging dist/main",
    "start:production": "node --env-file=.env.production dist/main",
    "migrate:local": "DOTENV_CONFIG_PATH=.env.local prisma migrate deploy",
    "migrate:development": "DOTENV_CONFIG_PATH=.env.development prisma migrate deploy",
    "migrate:staging": "DOTENV_CONFIG_PATH=.env.staging prisma migrate deploy",
    "migrate:production": "DOTENV_CONFIG_PATH=.env.production prisma migrate deploy",
    "seed:local": "DOTENV_CONFIG_PATH=.env.local prisma db seed",
    "seed:development": "DOTENV_CONFIG_PATH=.env.development prisma db seed",
    "seed:staging": "DOTENV_CONFIG_PATH=.env.staging prisma db seed",
    "seed:production": "DOTENV_CONFIG_PATH=.env.production prisma db seed",
    "db:status:local": "DOTENV_CONFIG_PATH=.env.local prisma migrate status",
    "db:status:development": "DOTENV_CONFIG_PATH=.env.development prisma migrate status",
    "db:status:staging": "DOTENV_CONFIG_PATH=.env.staging prisma migrate status",
    "db:status:production": "DOTENV_CONFIG_PATH=.env.production prisma migrate status",
    "studio:local": "DOTENV_CONFIG_PATH=.env.local prisma studio",
    "studio:staging": "DOTENV_CONFIG_PATH=.env.staging prisma studio",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "type-check": "tsc -p tsconfig.build.json --noEmit",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@repo/types": "*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.7",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "multer": "^2.2.0",
    "nestjs-pino": "^4.6.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@repo/eslint-config": "*",
    "@repo/tsconfig": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "jest": "^30.0.0",
    "prisma": "^7.9.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
