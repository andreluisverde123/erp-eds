# =============================================================================
# STAGING — API
# =============================================================================
# Template versionado. Copie para `.env.staging` (que é gitignorado) e preencha:
#
#   cp apps/api/.env.staging.example apps/api/.env.staging
#
# `.env.example` é a referência canônica: explica o que CADA variável faz.
# Este arquivo é a lista completa com os valores próprios de staging — precisa
# estar completo porque `node --env-file` e `DOTENV_CONFIG_PATH` SUBSTITUEM o
# ambiente, não fazem merge com `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# NODE_ENV=production em STAGING não é engano. Leia antes de "corrigir".
# -----------------------------------------------------------------------------
# O schema aceita o valor `staging`, mas quatro comportamentos do sistema estão
# presos a `NODE_ENV === 'production'`, e todos degradam EM SILÊNCIO com
# `staging`:
#
#   env.validation.ts:38,43  sslmode deixa de ser obrigatório na URL do Postgres
#   env.validation.ts:53     CORS_ORIGIN deixa de ser obrigatória (cai para localhost)
#   refresh-cookie.ts:24     o cookie de refresh perde a flag Secure
#   app.module.ts:54         os logs saem em pino-pretty em vez de JSON
#
# Um staging com essas quatro diferenças não valida o que produção vai fazer —
# que é a única razão de staging existir. Aqui `NODE_ENV` significa "modo de
# execução", e o AMBIENTE é identificado pelo arquivo carregado e pelos valores
# dentro dele (branch do Neon, domínio, segredos).
NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# Neon — branch/projeto de STAGING (eds-staging)
# -----------------------------------------------------------------------------
# Copie as duas strings do painel do Neon (Connection Details):
#
#   DATABASE_URL -> endpoint COM o sufixo `-pooler`  (aplicação)
#   DIRECT_URL   -> o mesmo host SEM `-pooler`       (prisma migrate)
#
# Ambas na porta 5432 — no Neon não há porta separada para o pooler, ao
# contrário do Supabase. `?sslmode=verify-full` é OBRIGATÓRIO: o driver (`pg`, via
# PrismaPg) só negocia TLS se o parâmetro estiver na string, e a API se recusa a
# subir sem ele. As strings do painel do Neon já vêm com o parâmetro.
# Use `sslmode=verify-full`, não `require`: no pg 8.x os dois são equivalentes
# (valida cadeia E hostname), mas a partir do pg 9 o `require` adota a semântica
# do libpq e DEIXA DE VERIFICAR o certificado — em silêncio, sem erro nem log.
# `verify-full` trava o comportamento seguro e é imune a essa mudança.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-XXXX-pooler.REGIAO.aws.neon.tech/eds-staging?sslmode=verify-full"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-XXXX.REGIAO.aws.neon.tech/eds-staging?sslmode=verify-full"

# -----------------------------------------------------------------------------
# Rede
# -----------------------------------------------------------------------------
# Domínio de staging, exatamente como o navegador o vê (com esquema, sem barra
# final). Precisa ser HTTPS: o cookie de refresh é Secure.
CORS_ORIGIN="https://staging.edsconstrutora.com.br"

# 1 quando há nginx/load balancer na frente (é o caso do docker-compose.prod.yml).
TRUST_PROXY=1

# Origem única (o nginx repassa /api): o navegador vê /api/auth/refresh, então o
# cookie precisa nascer em /api/auth. Com /auth a sessão cai 15 min após o login.
REFRESH_COOKIE_PATH="/api/auth"

# -----------------------------------------------------------------------------
# JWT — segredos EXCLUSIVOS de staging
# -----------------------------------------------------------------------------
# Nunca reaproveite os de produção: quem tem acesso a staging passaria a
# conseguir forjar um token válido em produção. Gere com:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="COLE_AQUI_UM_SEGREDO_DE_NO_MINIMO_32_CARACTERES"
JWT_REFRESH_SECRET="COLE_AQUI_OUTRO_SEGREDO_DIFERENTE_DO_DE_CIMA"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
LOG_LEVEL="info"

# Auto-cadastro de empresa. Desligado — o primeiro acesso vem do bootstrap do
# seed, não desta rota.
PUBLIC_SIGNUP_ENABLED=false

# Dados de demonstração. Em staging vale considerar `true` para ter massa de
# teste sem digitar tudo à mão — MAS ele cria seis usuários com a mesma senha
# conhecida (`Eds@12345`). Só ligue se staging não for acessível publicamente.
SEED_DEMO=false

# -----------------------------------------------------------------------------
# Primeiro acesso (bootstrap) — preencher SÓ na primeira carga do banco
# -----------------------------------------------------------------------------
# Sem estas duas, `prisma db seed` popula apenas o catálogo de permissões: o
# banco fica sem empresa, sem papéis e sem usuário, e ninguém consegue entrar.
# A senha é temporária por desenho (o sistema exige a troca no primeiro login).
# Remova as duas linhas depois do primeiro acesso.
# BOOTSTRAP_ADMIN_EMAIL="admin@edsconstrutora.com.br"
# BOOTSTRAP_ADMIN_PASSWORD=""
# BOOTSTRAP_ADMIN_NAME="Administrador"
# BOOTSTRAP_COMPANY_NAME="EDS Construtora"

# -----------------------------------------------------------------------------
# Cloudflare Tunnel nomeado (opcional) — publica em domínio próprio com TLS
# -----------------------------------------------------------------------------
# Token de Zero Trust > Networks > Tunnels > (seu túnel) > Install connector.
# É CREDENCIAL: quem o tiver publica o que quiser nesse hostname. Só faz efeito
# com `--profile tunnel-named` no docker compose.
# CLOUDFLARE_TUNNEL_TOKEN=""

# -----------------------------------------------------------------------------
# Armazenamento de arquivo
# -----------------------------------------------------------------------------
# `local` grava em <cwd>/uploads e exige volume montado + UMA réplica da API.
# Para staging refletir produção, use o mesmo driver que produção usará.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="uploads"
# S3_BUCKET="eds-staging-uploads"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE=false
