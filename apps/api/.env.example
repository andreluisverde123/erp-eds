PORT=3000
NODE_ENV=development

# Origem do frontend liberada no CORS (precisa de credentials: true para o
# cookie httpOnly do refresh token trafegar entre localhost:5173 e a API).
# Obrigatória quando NODE_ENV=production. Aceita várias origens separadas
# por vírgula.
CORS_ORIGIN="http://localhost:5173"

# Quantos proxies existem na frente da API (nginx/ALB/Fly = 1). Deixe 0 em
# desenvolvimento: com 0 o Express ignora o X-Forwarded-For, e é isso que você
# quer quando não há proxy nenhum (senão qualquer cliente forja o próprio IP e
# escapa do rate limit). Em produção atrás de proxy, defina 1.
TRUST_PROXY=0

# Segredos de assinatura dos tokens JWT. Gere valores próprios por ambiente,
# nunca reutilize os mesmos segredos entre dev/staging/produção
# (ex.: openssl rand -base64 48).
# Caminho do cookie do refresh token. Deixe /auth quando o front chamar a API
# direto (dev). Num deploy de origem única — nginx servindo o SPA e repassando
# /api para a API — precisa ser /api/auth, senão o navegador não manda o cookie
# no refresh e a sessão cai 15 minutos depois do login.
REFRESH_COOKIE_PATH="/auth"

JWT_ACCESS_SECRET="troque-este-segredo-do-access-token"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-segredo-do-refresh-token"
JWT_REFRESH_EXPIRES_IN="7d"

# Postgres. Qualquer Postgres 16+ serve — Docker local, Neon, RDS, Supabase.
# O sistema fala com o banco por Prisma; não há dependência de fornecedor.
#
# DATABASE_URL: conexão da aplicação (pelo pooler, quando houver).
# DIRECT_URL:   conexão direta, usada só pelo `prisma migrate` — o pooler em
#               transaction mode não suporta os comandos de DDL/advisory lock
#               que o Migrate precisa executar.
#
# ATENÇÃO AO sslmode. A aplicação conecta pelo driver adapter (PrismaPg → pg), e
# o pg só liga TLS se `sslmode` estiver NA STRING. Sem ele, um banco gerenciado
# recusa a conexão (erro no boot) e um banco que aceite texto puro sobe calado,
# com as credenciais trafegando sem criptografia. Em NODE_ENV=production a API
# se recusa a subir sem `sslmode` declarado — ver env.validation.ts.
#
# Em desenvolvimento (docker/docker-compose.yml) as duas são iguais e sem TLS:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eds"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/eds"
#
# --- Neon (produção) -------------------------------------------------------
# O pooler é o MESMO host com o sufixo `-pooler`, na porta 5432 (não há porta
# separada). O endpoint direto é o host sem o sufixo. Copie as duas strings do
# painel do Neon — elas já vêm com `sslmode=require`.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.sa-east-1.aws.neon.tech/eds?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/eds?sslmode=require"
#
# Se o scale-to-zero do projeto Neon estiver ligado, a primeira conexão depois
# de um período ocioso leva alguns segundos. O HEALTHCHECK da imagem da API
# (start-period de 40s) já acomoda isso; um orquestrador externo precisa da
# mesma folga, senão marca o container como unhealthy num cold start.
#
# --- Postgres na própria rede (compose --profile local-db) -----------------
# Sem TLS, e por isso o `sslmode` precisa ser declarado explicitamente:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/eds?sslmode=disable"
# DIRECT_URL="postgresql://postgres:postgres@postgres:5432/eds?sslmode=disable"
#
# --- Supabase --------------------------------------------------------------
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Primeiro acesso de uma instalação NOVA. O `prisma db seed` só popula o
# catálogo de permissões (tabela global, sem dono); sem as duas variáveis abaixo
# o banco fica sem empresa, sem papéis e sem usuário — o sistema sobe saudável e
# ninguém consegue entrar.
#
# Com elas definidas, o seed cria a empresa, os 6 papéis padrão e o
# administrador. A senha é tratada como TEMPORÁRIA: o sistema exige a troca no
# primeiro acesso (ela passou por um arquivo .env, então não serve como senha
# definitiva). Mesma regra da aplicação: 8 a 72 caracteres, ao menos uma letra e
# um número.
#
# É idempotente e seguro deixar no lugar: se já existe qualquer usuário no
# banco, o bootstrap não faz nada. Ainda assim, remova as variáveis do ambiente
# depois do primeiro acesso — não há razão para a senha continuar em disco.
# BOOTSTRAP_ADMIN_EMAIL="admin@edsconstrutora.com.br"
# BOOTSTRAP_ADMIN_PASSWORD=""
# Opcionais:
# BOOTSTRAP_ADMIN_NAME="Administrador"
# BOOTSTRAP_COMPANY_NAME="EDS Construtora"

# Dados de demonstração no `prisma db seed`: uma empresa-vitrine com dados de
# exemplo e senha conhecida em todos os usuários. NUNCA `true` em ambiente
# publicado.
SEED_DEMO=false

# Auto-cadastro de empresa (POST /onboarding/signup). Este ERP é da EDS e tem
# uma empresa só — nenhum usuário se cadastra sozinho, o administrador cria os
# acessos em Configurações > Usuários. Ligue apenas para provisionar uma base
# nova (homologação, migração de servidor) e desligue logo em seguida.
PUBLIC_SIGNUP_ENABLED=false

# Nível de log do pino (fatal|error|warn|info|debug|trace|silent). Em
# NODE_ENV=production a saída é JSON de uma linha; fora dela, pretty-print.
LOG_LEVEL="info"

# Armazenamento de arquivos (holerites, documentos de contrato, logo, anexos).
#
# `local` grava em <cwd>/uploads — bom para desenvolvimento e para instalação
# em servidor único. Em container, monte um volume em /app/apps/api/uploads,
# senão os arquivos somem a cada deploy. IMPORTANTE: disco local só funciona
# com UMA instância da API; com duas réplicas, o arquivo enviado numa não
# existe na outra.
#
# `s3` funciona com qualquer serviço compatível — AWS S3, MinIO, Cloudflare R2,
# Supabase Storage. Os arquivos continuam sendo servidos pela API (/uploads/...),
# mantendo as checagens de permissão; nada de URL pública.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="uploads"

# Preencha apenas quando STORAGE_DRIVER=s3 (aí passam a ser obrigatórias).
# S3_ENDPOINT e S3_FORCE_PATH_STYLE só são necessários fora da AWS: MinIO e R2
# não aceitam o bucket como subdomínio.
# S3_BUCKET="eds-uploads"
# S3_REGION="us-east-1"
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE=true
