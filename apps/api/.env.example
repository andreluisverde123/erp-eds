PORT=3000
NODE_ENV=development

# Origem do frontend liberada no CORS (precisa de credentials: true para o
# cookie httpOnly do refresh token trafegar entre localhost:5173 e a API).
# Obrigatória quando NODE_ENV=production. Aceita várias origens separadas
# por vírgula.
CORS_ORIGIN="http://localhost:5173"

# Quantos proxies existem na frente da API (nginx/ALB/Fly = 1). Deixe 0 em
# desenvolvimento: com 0 o Express ignora o X-Forwarded-For, e é isso que você
# quer quando não há proxy nenhum (senão qualquer cliente forja o próprio IP e
# escapa do rate limit). Em produção atrás de proxy, defina 1.
TRUST_PROXY=0

# Segredos de assinatura dos tokens JWT. Gere valores próprios por ambiente,
# nunca reutilize os mesmos segredos entre dev/staging/produção
# (ex.: openssl rand -base64 48).
# Caminho do cookie do refresh token. Deixe /auth quando o front chamar a API
# direto (dev). Num deploy de origem única — nginx servindo o SPA e repassando
# /api para a API — precisa ser /api/auth, senão o navegador não manda o cookie
# no refresh e a sessão cai 15 minutos depois do login.
REFRESH_COOKIE_PATH="/auth"

JWT_ACCESS_SECRET="troque-este-segredo-do-access-token"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-segredo-do-refresh-token"
JWT_REFRESH_EXPIRES_IN="7d"

# Postgres. Qualquer Postgres 16+ serve — Docker local, RDS, Neon, Supabase.
# O sistema fala com o banco por Prisma; não há dependência de fornecedor.
#
# DATABASE_URL: conexão da aplicação.
# DIRECT_URL:   conexão direta, usada só pelo `prisma migrate`.
#
# Em desenvolvimento (docker/docker-compose.yml) as duas são iguais:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eds"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/eds"
#
# Atrás de um pooler em transaction mode (Supabase/PgBouncer), a aplicação usa
# a porta do pooler e o migrate a porta direta — o pooler não suporta os
# comandos que o Migrate precisa executar:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Dados de demonstração no `prisma db seed`: uma empresa-vitrine com dados de
# exemplo e senha conhecida em todos os usuários. NUNCA `true` em ambiente
# publicado.
SEED_DEMO=false

# Nível de log do pino (fatal|error|warn|info|debug|trace|silent). Em
# NODE_ENV=production a saída é JSON de uma linha; fora dela, pretty-print.
LOG_LEVEL="info"

# Armazenamento de arquivos (holerites, documentos de contrato, logo, anexos).
#
# `local` grava em <cwd>/uploads — bom para desenvolvimento e para instalação
# em servidor único. Em container, monte um volume em /app/apps/api/uploads,
# senão os arquivos somem a cada deploy. IMPORTANTE: disco local só funciona
# com UMA instância da API; com duas réplicas, o arquivo enviado numa não
# existe na outra.
#
# `s3` funciona com qualquer serviço compatível — AWS S3, MinIO, Cloudflare R2,
# Supabase Storage. Os arquivos continuam sendo servidos pela API (/uploads/...),
# mantendo as checagens de permissão; nada de URL pública.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="uploads"

# Preencha apenas quando STORAGE_DRIVER=s3 (aí passam a ser obrigatórias).
# S3_ENDPOINT e S3_FORCE_PATH_STYLE só são necessários fora da AWS: MinIO e R2
# não aceitam o bucket como subdomínio.
# S3_BUCKET="eds-uploads"
# S3_REGION="us-east-1"
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE=true
