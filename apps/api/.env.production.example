# =============================================================================
# PRODUCTION — API
# =============================================================================
# Template versionado. Copie para `.env.production` (gitignorado) e preencha:
#
#   cp apps/api/.env.production.example apps/api/.env.production
#
# `.env.example` é a referência canônica de cada variável. Este arquivo é a
# lista completa com os valores de produção — precisa estar completo porque
# `node --env-file` e `DOTENV_CONFIG_PATH` SUBSTITUEM o ambiente.
#
# NOTA: num orquestrador (ECS, Fly, Kubernetes) prefira injetar estas variáveis
# como secrets do próprio orquestrador, sem arquivo em disco. Este template
# continua sendo a lista do que precisa existir.
# =============================================================================

NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# Neon — projeto/branch de PRODUÇÃO
# -----------------------------------------------------------------------------
# DATABASE_URL -> endpoint COM `-pooler` (aplicação)
# DIRECT_URL   -> mesmo host SEM `-pooler` (prisma migrate)
# O sslmode é obrigatório — a API não sobe sem ele. Use `verify-full`, não
# `require`: hoje são equivalentes, mas a partir do pg 9 o `require` deixa de
# verificar o certificado, em silêncio.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-XXXX-pooler.REGIAO.aws.neon.tech/eds?sslmode=verify-full"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-XXXX.REGIAO.aws.neon.tech/eds?sslmode=verify-full"

# -----------------------------------------------------------------------------
# Rede
# -----------------------------------------------------------------------------
CORS_ORIGIN="https://erp.edsconstrutora.com.br"
TRUST_PROXY=1
REFRESH_COOKIE_PATH="/api/auth"

# -----------------------------------------------------------------------------
# JWT — segredos EXCLUSIVOS de produção
# -----------------------------------------------------------------------------
# Gere novos (`openssl rand -base64 48`). Não reaproveite os de staging: quem
# tem acesso a staging passaria a conseguir forjar token válido aqui.
JWT_ACCESS_SECRET="COLE_AQUI_UM_SEGREDO_DE_NO_MINIMO_32_CARACTERES"
JWT_REFRESH_SECRET="COLE_AQUI_OUTRO_SEGREDO_DIFERENTE_DO_DE_CIMA"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
LOG_LEVEL="info"

# NUNCA `true` em produção: criaria uma empresa fictícia e seis usuários com a
# mesma senha conhecida.
SEED_DEMO=false

# Auto-cadastro de empresa: desligado. O ERP da EDS tem uma empresa só.
PUBLIC_SIGNUP_ENABLED=false

# -----------------------------------------------------------------------------
# Primeiro acesso (bootstrap) — SÓ na primeira carga do banco
# -----------------------------------------------------------------------------
# Depois do primeiro login, REMOVA as duas linhas do ambiente. Não há razão para
# a senha continuar em disco.
# BOOTSTRAP_ADMIN_EMAIL="admin@edsconstrutora.com.br"
# BOOTSTRAP_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Cloudflare Tunnel nomeado (opcional) — publica em domínio próprio com TLS
# -----------------------------------------------------------------------------
# Token de Zero Trust > Networks > Tunnels > (seu túnel) > Install connector.
# É CREDENCIAL: quem o tiver publica o que quiser nesse hostname. Só faz efeito
# com `--profile tunnel-named` no docker compose.
# CLOUDFLARE_TUNNEL_TOKEN=""

# -----------------------------------------------------------------------------
# Armazenamento de arquivo
# -----------------------------------------------------------------------------
# `local` exige volume montado em /app/apps/api/uploads e UMA réplica da API —
# com duas, o anexo enviado numa não existe na outra.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="uploads"
# S3_BUCKET="eds-uploads"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
