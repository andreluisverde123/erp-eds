# =============================================================================
# DEVELOPMENT — API (ambiente COMPARTILHADO de desenvolvimento)
# =============================================================================
# Copie para `.env.development` (gitignorado):
#
#   cp apps/api/.env.development.example apps/api/.env.development
#
# Não confundir com LOCAL:
#
#   local        cada dev na própria máquina, Postgres em container, dado descartável
#   development  UM ambiente publicado, compartilhado pelo time, banco no Neon
#
# Se a EDS não tiver um ambiente de desenvolvimento publicado, este arquivo não
# é necessário — a escada vira `local → staging → production`. Ele existe para
# que a estrutura suporte os quatro ambientes pedidos, sem obrigar a usar todos.
# =============================================================================

# Ambiente publicado, ainda que interno: vale a mesma regra do staging.
# `NODE_ENV=development` desligaria a exigência de sslmode e de CORS_ORIGIN, e
# tiraria o Secure do cookie de refresh. Ver o cabeçalho de
# `.env.staging.example` para a lista completa.
NODE_ENV=production
PORT=3000

# Neon — branch de desenvolvimento (ex.: `eds-dev`).
# Use `sslmode=verify-full`, não `require`: no pg 8.x os dois são equivalentes
# (valida cadeia E hostname), mas a partir do pg 9 o `require` adota a semântica
# do libpq e DEIXA DE VERIFICAR o certificado — em silêncio, sem erro nem log.
# `verify-full` trava o comportamento seguro e é imune a essa mudança.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-XXXX-pooler.REGIAO.aws.neon.tech/eds-dev?sslmode=verify-full"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-XXXX.REGIAO.aws.neon.tech/eds-dev?sslmode=verify-full"

CORS_ORIGIN="https://dev.edsconstrutora.com.br,https://diario.dev.edsconstrutora.com.br"
TRUST_PROXY=1
REFRESH_COOKIE_PATH="/api/auth"

# Sessão compartilhada entre o ERP e o Diário de Obras, que vivem em
# subdomínios do MESMO domínio. Sem esta variável o cookie nasce host-only: o
# navegador não o envia para o outro subdomínio, e quem entra no ERP tem que
# entrar de novo no Diário — com as mesmas credenciais, por pura mecânica de
# cookie.
#
# Ligar isto é declarar que TODOS os subdomínios deste domínio pertencem a este
# sistema. Se algum dia um deles for servido por outra coisa, o cookie de sessão
# vai junto. Deixe vazio se não houver subdomínio a compartilhar.
REFRESH_COOKIE_DOMAIN=".dev.edsconstrutora.com.br"


# Segredos exclusivos deste ambiente.
JWT_ACCESS_SECRET="COLE_AQUI_UM_SEGREDO_DE_NO_MINIMO_32_CARACTERES"
JWT_REFRESH_SECRET="COLE_AQUI_OUTRO_SEGREDO_DIFERENTE_DO_DE_CIMA"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# `debug` é aceitável aqui — é o ambiente onde se investiga. Em staging e
# produção use `info`.
LOG_LEVEL="debug"

# Massa de exemplo com senha conhecida. Só deixe `true` se o ambiente não for
# alcançável pela internet.
SEED_DEMO=false
PUBLIC_SIGNUP_ENABLED=false

# BOOTSTRAP_ADMIN_EMAIL="admin@edsconstrutora.com.br"
# BOOTSTRAP_ADMIN_PASSWORD=""

STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="uploads"
