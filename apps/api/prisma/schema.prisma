generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRoleType {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ENGINEER
  BUYER
  HR_ANALYST
  FINANCE_ANALYST
  VIEWER
  /// Fiscal DE OBRA — quem acompanha a execução em campo e assina o diário
  /// pelo contratante. Nada a ver com o módulo `fiscal` do código, que é
  /// tributário (NF-e, certificado digital, DF-e): a palavra é a mesma, o
  /// assunto não. Valor novo em vez de reaproveitar `ENGINEER` porque as duas
  /// funções assinam o RDO em papéis opostos.
  SITE_INSPECTOR
}

/// Em que papel a pessoa participa DAQUELA obra. Não substitui o RBAC: o
/// papel (`Role`) decide o que o usuário pode FAZER no sistema; isto decide
/// como ele aparece NAQUELA obra — quem assina o diário como responsável
/// técnico e quem assina como fiscal. A mesma pessoa pode ser engenheiro numa
/// obra e fiscal em outra, e nenhum papel de RBAC consegue expressar isso.
enum SiteAssignmentRole {
  ENGINEER
  /// Fiscal de obra. Ver a nota em `UserRoleType.SITE_INSPECTOR`.
  INSPECTOR
}

/// Condição do tempo num período do dia. Enumerado, e não texto livre, porque
/// o clima do RDO vira estatística: "quantos dias de chuva esta obra teve em
/// março" é uma pergunta de medição contratual, e ela não se responde sobre uma
/// coluna onde cabem "chuva", "Chuvoso", "chuva forte" e "🌧️".
enum WeatherCondition {
  SUNNY
  PARTLY_CLOUDY
  CLOUDY
  RAIN
  STORM
}

/// Que tipo de evidência visual é o arquivo.
///
/// Enum, e não texto: a tela agrupa fotos e vídeos em seções diferentes, e um
/// `type` livre transformaria "PHOTO"/"photo"/"foto" em três seções.
enum DailyReportMediaType {
  PHOTO
  VIDEO
}

/// Unidade de medida do material movimentado no dia.
///
/// **Enum, e não `String` livre como em `PurchaseRequestItem.unit`.** Lá o
/// campo é texto porque o seed já havia gravado abreviações do setor antes de
/// existir catálogo, e enumerá-lo hoje exigiria migrar dado. Aqui a tabela
/// nasce vazia: dá para exigir um valor válido desde o primeiro registro, e é
/// o backend que passa a recusar unidade inventada, não a boa vontade da tela.
///
/// Os códigos que existem nos dois lugares são os MESMOS de
/// `MEASUREMENT_UNITS` (`apps/web/src/lib/measurement-units.ts`) — `SC`, `CX`,
/// `PCT` e não `SACO`/`CAIXA`/`PACOTE`. Não é preciosismo: no dia em que
/// alguém quiser abrir uma solicitação de compra a partir do material faltante
/// de um RDO, a unidade atravessa sem tabela de tradução.
enum MaterialUnit {
  UN
  KG
  TON
  M
  M2
  M3
  L
  SC
  CX
  PCT
  /// Escape para o que não cabe na lista. Existe para ninguém escolher uma
  /// unidade errada só porque a certa não estava lá — a quantidade continua
  /// registrada, e a descrição diz do que se trata.
  OTHER
}

/// O que aconteceu com o material na obra naquele dia.
///
/// É movimentação de DIÁRIO, não de estoque: não há saldo, custo, fornecedor
/// nem nota. A pergunta que estes quatro valores respondem é "o que entrou,
/// saiu ou voltou hoje", e o histórico de uma obra se lê percorrendo os RDOs.
enum MaterialMovementType {
  RECEIVED
  USED
  RETURNED
  OTHER
}

/// Classificação da ocorrência registrada no dia.
///
/// Dez valores, e não trinta: o objetivo é permitir filtrar e contar, não
/// descrever. O detalhe do que aconteceu vive na descrição, que é texto livre —
/// uma taxonomia grande demais faz todo mundo escolher "Outro".
///
/// `INSPECTION` (fiscalização) e `DESIGN` (projeto) não são problemas; a
/// palavra "ocorrência" aqui significa "o que aconteceu de digno de registro",
/// não "o que deu errado".
enum OccurrenceType {
  MATERIAL
  LABOR
  EQUIPMENT
  WEATHER
  DESIGN
  SAFETY
  SCHEDULE
  INSPECTION
  STOPPAGE
  OTHER
}

/// Situação do relatório diário de obra (RDO).
///
/// O ciclo implementado hoje tem DOIS estados e UMA transição:
///
///   DRAFT ──finalizar──> SUBMITTED
///
/// `APPROVED` continua no enum como o degrau da conferência pelo
/// fiscal/contratante, que ainda não existe. Ele NÃO é alcançável por rota
/// nenhuma — nenhum código o produz — e está aqui porque removê-lo e
/// recolocá-lo depois custaria duas migrations para chegar ao mesmo lugar.
///
/// **Não existe estado de "em revisão", e não é esquecimento.** Um estado
/// intermediário só se justifica quando alguém age sobre ele; enquanto a
/// aprovação não existir, REVIEW seria um beco — o relatório entraria e não
/// teria como sair. O fluxo cresce quando aparecer o ator que o justifica.
enum DailyReportStatus {
  /// Em preenchimento pelo autor, ainda editável.
  DRAFT
  /// Finalizado pelo autor. A partir daqui o conteúdo é histórico e nenhuma
  /// escrita é aceita — ver `isEditable`.
  SUBMITTED
  /// Conferido pelo fiscal/contratante. Reservado; ainda não alcançável.
  APPROVED
}

enum ConstructionStatus {
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

/// Como o fornecedor entrou no cadastro. `NFE` marca os que o importador
/// fiscal criou sozinho a partir do emitente de uma nota — o usuário nunca
/// digitou aqueles dados, e a tela precisa dizer isso antes que alguém trate
/// um cadastro de uma linha só como se tivesse sido conferido por alguém.
enum SupplierOrigin {
  MANUAL
  NFE
}

/// Fluxo linear: DRAFT -> PENDING -> QUOTING -> APPROVED, com CANCELLED
/// acessível de qualquer estado não-terminal. Sem aprovação em níveis nem
/// cotação múltipla nesta etapa — QUOTING é só um rótulo de estágio.
enum PurchaseRequestStatus {
  DRAFT
  PENDING
  QUOTING
  APPROVED
  CANCELLED
}

/// Como um desconto foi INFORMADO. O valor em reais é sempre derivado da
/// base a que o desconto se aplica — guardar o tipo preserva a intenção de
/// quem digitou: "10%" continua valendo 10% se o preço mudar, enquanto
/// "R$ 100" continua sendo cem reais.
enum DiscountType {
  AMOUNT
  PERCENT
}

enum PurchaseOrderStatus {
  OPEN
  ISSUED
  RECEIVED
  CANCELLED
}

enum InvoiceStatus {
  RECEIVED
  VALIDATED
  CANCELLED
}

/// Situação da parcela de contas a pagar. "Vencendo hoje/na semana" (tela de
/// Contas a Pagar) é calculado a partir de `dueDate` em tempo real, não é um
/// status armazenado — evita a parcela ficar "presa" num status desatualizado.
enum AccountPayableStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

/// Como o boleto entrou no sistema.
enum BankSlipSource {
  /// Arquivo enviado e lido pelo extrator.
  PDF_UPLOAD
  /// Linha digitável informada por uma pessoa — caminho de primeira classe,
  /// não remendo: boleto escaneado e PDF de layout exótico caem aqui, e a
  /// linha digitável sozinha já traz banco, valor e vencimento.
  MANUAL_ENTRY
}

/// Situação do boleto dentro do fluxo de conferência.
enum BankSlipStatus {
  /// Lido, aguardando alguém confirmar a qual conta a pagar ele pertence.
  PENDING
  /// Vinculado a uma conta a pagar. Não significa pago — pagamento continua
  /// sendo `Payment`, e nada aqui dá baixa em nada.
  LINKED
}

/// De onde a conta a pagar nasceu.
///
/// DUAS opções, e não três, apesar de o negócio falar em "NF", "OC" e
/// "manual": no modelo atual existem exatamente DOIS caminhos de criação —
/// a partir de uma `Invoice` (seja ela lançada à mão ou criada pela
/// conciliação) ou direto pelo Financeiro. Um terceiro valor seria ambíguo,
/// porque uma conta vinda de nota conciliada QUE TEM ordem de compra seria
/// "NF" e "OC" ao mesmo tempo.
///
/// O detalhe continua respondível sem inventar valor: `invoice.purchaseOrderId`
/// diz se houve ordem, e `invoice.inboundInvoices` diz se houve conciliação.
enum AccountPayableOrigin {
  /// Nasceu de uma nota fiscal — o caminho que já existia.
  INVOICE
  /// Lançada direto pelo Financeiro, sem solicitação, ordem ou nota.
  MANUAL
}

/// Status do registro de pagamento em si (distinto do status da parcela que
/// ele quita — um pagamento PENDING/PROCESSING ainda não abate o saldo da
/// AccountPayable; só um pagamento PAID conta pra recalcular o status dela).
enum PaymentRecordStatus {
  PENDING
  PROCESSING
  PAID
  REFUNDED
}

enum EmployeeStatus {
  ACTIVE
  VACATION
  ON_LEAVE
  TERMINATED
}

/// Situação de um apontamento de ponto. Calculado pelo backend a partir de
/// entrada/saída (nunca setado à mão pelo cliente): CLOSED quando ambos os
/// horários batem, INCONSISTENT quando faltam/colidem, OPEN enquanto ainda
/// não há saída registrada.
enum TimeEntryStatus {
  OPEN
  CLOSED
  INCONSISTENT
}

enum ContractorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

/// Encerramento manual de um contrato (antes do prazo). O badge exibido na
/// tela (Vigente/Vencendo/Encerrado) é derivado combinando este status com
/// `endDate` — nunca é um terceiro valor armazenado.
enum ContractStatus {
  ACTIVE
  CANCELLED
}

/// Natureza da conta bancária. Os três tipos que um banco brasileiro abre para
/// pessoa física — conta de pagamento é a das fintechs (Nubank, PicPay, Mercado
/// Pago), que não é corrente nem poupança e precisa ser informada como tal nos
/// arquivos de remessa.
enum BankAccountType {
  CHECKING
  SAVINGS
  PAYMENT
}

/// Tipos de chave PIX aceitos pelo Banco Central. `RANDOM` é a chave
/// aleatória (EVP), um UUID gerado pelo próprio banco.
enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

/// Tipo de ação registrada no log de auditoria.
///
/// `READ` não é registrado para consulta comum — seria ruído em cima de toda
/// listagem do sistema. Ele existe para o punhado de leituras que EXPÕEM dado
/// protegido e por isso precisam de rastro: hoje, revelar os dados bancários
/// completos de alguém (ver `BankAccountsService.reveal`).
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ
}

enum SettingsTheme {
  LIGHT
  DARK
  SYSTEM
}

/// Situação comercial do tenant (Company) em si — distinto de `User.isActive`,
/// que é por usuário. `ACTIVE` e `TRIAL` permitem usar o sistema; `SUSPENDED`
/// e `CANCELLED` barram login e refresh (ver `assertCompanyActive`), então
/// suspender um cliente derruba também as sessões já abertas.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

/// Plano contratado pelo tenant. Mesma observação: só armazenado, nenhuma
/// regra de limite/feature-gate por plano existe ainda.
enum TenantPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// =============================================================================
// EMPRESA
// =============================================================================

/// Empresa (construtora) — raiz do isolamento multi-tenant do sistema.
/// Campos de tenant (slug/status/plan/timezone/locale/currency/cores) vivem
/// aqui em vez de numa entidade `Tenant` separada: `Company` já É a raiz de
/// isolamento (todo `companyId` do sistema aponta pra cá) — uma segunda
/// entidade paralela duplicaria esse papel sem necessidade.
model Company {
  id                String       @id @default(uuid()) @db.Uuid
  slug              String       @unique
  /// Opcional por causa do cadastro self-service: no trial a empresa entra só
  /// com nome, e-mail e senha — o CNPJ passa a ser exigido no momento de
  /// assinar/emitir nota, não na porta de entrada. Continua único: o Postgres
  /// permite vários NULL num índice único, então empresas em trial coexistem.
  cnpj              String?      @unique @db.VarChar(14)
  /// No cadastro nasce igual ao nome informado pelo usuário; a razão social
  /// de verdade é preenchida depois, em Configurações > Empresa.
  legalName         String
  tradeName         String?
  stateRegistration String?
  email             String?
  phone             String?
  website           String?
  logoUrl           String?
  addressLine       String?
  addressNumber     String?
  addressComplement String?
  city              String?
  state             String?      @db.VarChar(2)
  zipCode           String?      @db.VarChar(8)
  responsibleName   String?
  status            TenantStatus @default(ACTIVE)
  plan              TenantPlan   @default(STARTER)
  timezone          String       @default("America/Sao_Paulo")
  locale            String       @default("pt-BR")
  currency          String       @default("BRL")
  primaryColor      String?
  secondaryColor    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  users                   User[]
  roles                   Role[]
  constructionSites       ConstructionSite[]
  costCenters             CostCenter[]
  suppliers               Supplier[]
  purchaseRequests        PurchaseRequest[]
  purchaseOrders          PurchaseOrder[]
  employees               Employee[]
  contractors             Contractor[]
  contractorContracts     ContractorContract[]
  invoices                Invoice[]
  accountsPayable         AccountPayable[]
  bankAccounts            BankAccount[]
  bankSlips               BankSlip[]
  attachments             Attachment[]
  auditLogs               AuditLog[]
  workflowComments        WorkflowComment[]
  systemSettings          SystemSettings?
  notificationPreferences NotificationPreference[]
  inboundInvoices         InboundInvoice[]
  fiscalCertificate       FiscalCertificate?
  fiscalSyncState         FiscalSyncState?
  fiscalSyncRuns          FiscalSyncRun[]
  fiscalDocuments         FiscalDocument[]
  fiscalImportLogs        FiscalImportLog[]
  dailyReports            DailyReport[]
}

// =============================================================================
// USUÁRIOS
// =============================================================================

/// Usuário do sistema (colaborador com acesso ao ERP).
/// Distinto de Employee: nem todo funcionário (mão de obra) tem login no sistema,
/// e nem todo usuário do sistema é necessariamente um funcionário CLT (pode ser
/// um usuário administrativo, contador externo, etc.).
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @db.Uuid
  name               String
  email              String    @unique
  passwordHash       String
  phone              String?
  position           String?
  isActive           Boolean   @default(true)
  /// Ligado quando um admin cria o usuário ou reseta a senha dele: a senha
  /// temporária circula por fora do sistema (WhatsApp, papel, e-mail pessoal),
  /// então ela só serve para entrar uma vez. Enquanto estiver `true` a API
  /// bloqueia todas as rotas exceto trocar a própria senha.
  /// Nasce `false` no cadastro self-service — ali a senha foi escolhida pelo
  /// próprio dono da conta.
  mustChangePassword Boolean   @default(false)
  /// Interruptor do Diário de Obras POR PESSOA, sobrepondo o perfil.
  ///
  /// Existe porque "Engenharia" é um papel coletivo: a equipe inteira precisa
  /// das permissões do ERP, mas nem todo engenheiro vai a campo preencher RDO.
  /// Sem isto, liberar o Diário para um significa liberar para todos.
  ///
  /// Sobrepõe apenas para MENOS: as permissões `diario.*` continuam vindo do
  /// papel, e este campo pode retirá-las de uma pessoa — nunca conceder a quem
  /// o papel não deu. Aplicado em `toPublicUser`, o ponto único onde o conjunto
  /// efetivo é montado, para que guard e frontend não precisem de caso especial.
  ///
  /// Nasce `false` (ninguém entra sem alguém liberar), mas a migration marca
  /// `true` para quem JÁ tinha vínculo com obra — essas pessoas estavam usando
  /// o Diário, e tirá-las sem aviso seria uma regressão disfarçada de recurso.
  diarioEnabled      Boolean   @default(false)
  /// Aceite dos termos de uso, registrado no cadastro self-service. A VERSÃO
  /// importa tanto quanto a data: sem ela, um aceite antigo não prova o que
  /// foi aceito depois que o texto mudar. Fica em branco para os usuários
  /// criados por um admin dentro do sistema (aceite é da empresa, feito por
  /// quem assinou).
  acceptedTermsAt    DateTime?
  termsVersion       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  company                   Company                @relation(fields: [companyId], references: [id])
  userRoles                 UserRole[]
  refreshTokens             RefreshToken[]
  purchaseRequests          PurchaseRequest[]
  /// Ordens que este usuário emitiu — é o nome que assina o PDF da ordem.
  purchaseOrders            PurchaseOrder[]        @relation("PurchaseOrderCreatedBy")
  /// Obras das quais este usuário é o responsável.
  responsibleForSites       ConstructionSite[]     @relation("ConstructionSiteResponsible")
  attachments               Attachment[]
  auditLogs                 AuditLog[]
  workflowComments          WorkflowComment[]
  /// Notas que este usuário conciliou — a rastreabilidade de quem validou.
  reconciledInboundInvoices InboundInvoice[]
  fiscalCertificates        FiscalCertificate[]
  fiscalSyncRuns            FiscalSyncRun[]
  bankAccounts              BankAccount[]
  uploadedBankSlips         BankSlip[]             @relation("BankSlipUploadedBy")
  linkedBankSlips           BankSlip[]             @relation("BankSlipLinkedBy")
  /// Obras a que este usuário está vinculado — é o que o Diário de Obras lê
  /// para responder "quais obras eu vejo".
  constructionSites         UserConstructionSite[]
  dailyReports              DailyReport[]
  submittedDailyReports     DailyReport[]          @relation("DailyReportSubmittedBy")
  dailyReportMedia          DailyReportMedia[]

  @@index([companyId])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
}

/// Refresh token de sessão (um registro por token emitido). Armazena apenas o
/// hash do token (nunca o valor em texto puro) para que um vazamento do banco
/// não permita reconstruir sessões válidas. `revokedAt` é setado no logout ou
/// na rotação (reuso de um token já trocado invalida a cadeia inteira).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Papel/função atribuível a usuários (RBAC). `type` classifica o papel em uma
/// categoria de sistema; `name` é o rótulo específico definido pela empresa.
model Role {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  name        String
  type        UserRoleType
  description String?
  /// Papéis do seed (Administrador/Engenharia/Compras/Financeiro/RH/Diretoria)
  /// — protegidos contra exclusão/renomeação pra nunca deixar o sistema sem
  /// nenhum papel administrativo por engano. Papéis criados depois pelo
  /// usuário nascem com `false` e podem ser geridos livremente.
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  company         Company          @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// Catálogo de permissões do sistema (ação granular por módulo).
/// `module`/`action` ficam como texto livre (não enum) para permitir novas
/// permissões sem exigir migration a cada módulo/tela adicionado.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
}

/// Associação N:N entre Role e Permission.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

/// Associação N:N entre User e Role.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

/// Vínculo entre um usuário do sistema e uma obra — a fonte de verdade de
/// "quais obras esta pessoa enxerga" no Diário de Obras.
///
/// Precisou existir: até aqui NENHUMA tabela ligava `User` a
/// `ConstructionSite`. `EmployeeAllocation` liga obra a `Employee`, que é o
/// colaborador do RH (a maioria não tem login), e o comentário do próprio
/// `User` já registra que as duas entidades são propositalmente distintas.
/// Sem esta tabela, "engenheiro A não vê a obra do engenheiro B" não teria
/// como ser respondido pelo backend.
///
/// Não há coluna `companyId`: a obra já tem uma, e duplicá-la abriria a
/// possibilidade de vínculo entre usuário de uma empresa e obra de outra. Os
/// services cruzam `companyId` pela obra (ver `SiteAccessService`).
model UserConstructionSite {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  constructionSiteId String             @db.Uuid
  role               SiteAssignmentRole @default(ENGINEER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  constructionSite ConstructionSite @relation(fields: [constructionSiteId], references: [id], onDelete: Cascade)

  @@unique([userId, constructionSiteId])
  @@index([constructionSiteId])
}

// =============================================================================
// ENGENHARIA
// =============================================================================

/// Obra/canteiro de construção.
model ConstructionSite {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @db.Uuid
  code              String
  name              String
  clientName        String?
  /// O RESPONSÁVEL pela obra, como USUÁRIO do sistema.
  ///
  /// Escolhê-lo aqui é o que dá a ele a obra no Diário: o vínculo em
  /// `UserConstructionSite` nasce junto, sem uma segunda tela. Era a lacuna
  /// que fazia uma obra recém-cadastrada não aparecer para ninguém.
  responsibleId     String?            @db.Uuid
  /// O nome, mantido ao lado do vínculo e não derivado dele.
  ///
  /// Duas razões: as obras cadastradas antes disto têm um nome digitado e
  /// nenhum usuário, e apagá-lo perderia informação; e os documentos já
  /// emitidos (RDO, ordem de compra) citam o responsável pelo nome que valia
  /// na época — buscar o nome do usuário na hora de imprimir faria um PDF
  /// antigo mudar de conteúdo quando a pessoa trocasse de sobrenome.
  ///
  /// Quando um usuário é escolhido, o nome é gravado a partir dele.
  responsibleName   String?
  description       String?
  status            ConstructionStatus @default(PLANNING)
  /// ENDEREÇO DE ENTREGA da obra.
  ///
  /// `addressLine`, `city`, `state` e `zipCode` já existiam; o formulário só
  /// expunha cidade e UF, então na prática o endereço nunca era preenchido.
  /// Número, complemento e bairro entram agora porque sem eles o endereço não
  /// serve ao que motiva existir: o fornecedor precisa saber ONDE descarregar,
  /// e "Avenida Central, Goiânia" não é um lugar.
  ///
  /// Mesma decomposição já usada em `Company` e `Supplier` — um único campo de
  /// texto livre pareceria mais simples e impediria formatar o endereço nos
  /// documentos sem inventar vírgula onde falta dado (ver `joinAddress`).
  ///
  /// Tudo opcional: as obras já cadastradas não têm endereço, e exigi-lo
  /// travaria a edição de qualquer uma delas.
  addressLine       String?
  addressNumber     String?
  addressComplement String?
  neighborhood      String?
  city              String?
  state             String?            @db.VarChar(2)
  zipCode           String?            @db.VarChar(8)
  startDate         DateTime?
  expectedEndDate   DateTime?
  actualEndDate     DateTime?
  budgetAmount      Decimal?           @db.Decimal(14, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  company             Company                @relation(fields: [companyId], references: [id])
  responsible         User?                  @relation("ConstructionSiteResponsible", fields: [responsibleId], references: [id])
  costCenters         CostCenter[]
  employeeAllocations EmployeeAllocation[]
  timeEntries         TimeEntry[]
  productionEntries   ProductionEntry[]
  purchaseRequests    PurchaseRequest[]
  purchaseOrders      PurchaseOrder[]
  contractorContracts ContractorContract[]
  invoices            Invoice[]
  accountsPayable     AccountPayable[]
  userAccess          UserConstructionSite[]
  dailyReports        DailyReport[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "ConstructionSite_name_trgm_idx")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "ConstructionSite_code_trgm_idx")
  @@index([clientName(ops: raw("gin_trgm_ops"))], type: Gin, map: "ConstructionSite_clientName_trgm_idx")
}

/// Centro de custo. Pode pertencer a uma obra específica ou ser administrativo
/// (constructionSiteId nulo), cobrindo despesas de estrutura/overhead.
model CostCenter {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @db.Uuid
  constructionSiteId String?   @db.Uuid
  code               String
  name               String
  description        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  company          Company           @relation(fields: [companyId], references: [id])
  constructionSite ConstructionSite? @relation(fields: [constructionSiteId], references: [id])

  purchaseRequests    PurchaseRequest[]
  purchaseOrders      PurchaseOrder[]
  productionEntries   ProductionEntry[]
  employeeAllocations EmployeeAllocation[]
  invoices            Invoice[]
  accountsPayable     AccountPayable[]

  @@unique([companyId, code])
  @@index([constructionSiteId])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "CostCenter_name_trgm_idx")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "CostCenter_code_trgm_idx")
}

// =============================================================================
// COMPRAS
// =============================================================================

/// Fornecedor de materiais/serviços.
model Supplier {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @db.Uuid
  legalName   String
  tradeName   String?
  /// CNPJ ou CPF, SEMPRE só dígitos. A normalização acontece na entrada
  /// (`onlyDigits`, ver `common/utils/document.util.ts`) porque a unique
  /// abaixo é sobre o texto: sem ela, "12.345.678/0001-90" e
  /// "12345678000190" seriam dois fornecedores, e o emitente da NF-e — que
  /// chega sempre só com dígitos — nunca casaria com o cadastro.
  /// Exceção: o soft delete manga este campo (ver `mangleDeletedCode`), e o
  /// valor mangado deixa de ser só dígitos de propósito.
  document    String
  contactName String?
  email       String?
  phone       String?

  /// Inscrição estadual (`emit/IE` da NF-e). Opcional: emitente do Simples
  /// e produtor rural podem vir isento ou sem o campo.
  stateRegistration String?

  /// Endereço destrinchado nos mesmos campos que a NF-e usa (`enderEmit`),
  /// em vez de uma linha só: é assim que o dado chega, e remontá-lo numa
  /// string perderia a divisão na primeira vez que alguém precisasse do CEP
  /// ou do bairro isolado. `address` é o logradouro (`xLgr`).
  address           String?
  addressNumber     String?
  addressComplement String?
  neighborhood      String?
  city              String?
  state             String? @db.VarChar(2)
  zipCode           String? @db.VarChar(8)

  /// De onde veio o cadastro. Ver `SupplierOrigin`.
  origin          SupplierOrigin @default(MANUAL)
  /// A chave de acesso da nota que originou o cadastro automático. É o que
  /// torna a origem verificável: dá para abrir a nota e conferir de onde
  /// cada campo saiu. Nulo em cadastro manual.
  originAccessKey String?        @db.VarChar(44)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company         Company          @relation(fields: [companyId], references: [id])
  purchaseOrders  PurchaseOrder[]
  invoices        Invoice[]
  inboundInvoices InboundInvoice[]
  accountsPayable AccountPayable[]
  bankSlips       BankSlip[]

  @@unique([companyId, document])
  @@index([companyId])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([legalName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Supplier_legalName_trgm_idx")
  @@index([tradeName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Supplier_tradeName_trgm_idx")
  @@index([document(ops: raw("gin_trgm_ops"))], type: Gin, map: "Supplier_document_trgm_idx")
}

/// Requisição de compra originada por uma obra/centro de custo.
model PurchaseRequest {
  id                 String                @id @default(uuid()) @db.Uuid
  companyId          String                @db.Uuid
  /// ESCOLHIDO pelo solicitante, e o primeiro campo do formulário. Antes era
  /// derivado do centro de custo — quem pedia material escolhia uma conta
  /// contábil e a obra saía dela por tabela. A inversão existe porque quem
  /// abre a solicitação sabe para qual obra está pedindo, e frequentemente
  /// não sabe (nem deveria precisar saber) em qual centro de custo aquilo
  /// entra.
  constructionSiteId String                @db.Uuid
  /// OPCIONAL, e preenchido por quem souber: o solicitante, se conhecer o
  /// centro de custo, ou Compras na emissão da Ordem — que é onde ele volta a
  /// ser obrigatório. Mesma divisão de trabalho já aplicada ao preço, que o
  /// solicitante não informa e a cotação define.
  ///
  /// Quando informado, precisa pertencer à obra escolhida; o service valida.
  costCenterId       String?               @db.Uuid
  requestedById      String                @db.Uuid
  code               String
  status             PurchaseRequestStatus @default(DRAFT)
  notes              String?
  neededBy           DateTime?
  /// DESCONTO GERAL da cotação, aplicado sobre o subtotal JÁ LÍQUIDO dos
  /// descontos de item — nunca sobre o bruto, senão o mesmo abatimento
  /// entraria duas vezes. Ver `quote-totals.ts`.
  ///
  /// `0` é a ausência de desconto, e é o padrão: nenhuma solicitação existente
  /// muda de valor por causa desta coluna.
  ///
  /// O total NÃO é gravado. Ele é derivado de itens + descontos a cada
  /// leitura, como sempre foi — o que está aqui é a ENTRADA do cálculo, não o
  /// resultado dele.
  discountType       DiscountType          @default(AMOUNT)
  discountValue      Decimal               @default(0) @db.Decimal(14, 2)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?

  company          Company          @relation(fields: [companyId], references: [id])
  constructionSite ConstructionSite @relation(fields: [constructionSiteId], references: [id])
  costCenter       CostCenter?      @relation(fields: [costCenterId], references: [id])
  requestedBy      User             @relation(fields: [requestedById], references: [id])

  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, code])
  @@index([constructionSiteId])
  @@index([costCenterId])
  @@index([status])
  @@index([createdAt])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "PurchaseRequest_code_trgm_idx")
}

/// Item de linha de uma requisição de compra.
model PurchaseRequestItem {
  id                 String       @id @default(uuid()) @db.Uuid
  purchaseRequestId  String       @db.Uuid
  description        String
  quantity           Decimal      @db.Decimal(12, 3)
  unit               String
  estimatedUnitPrice Decimal?     @db.Decimal(14, 2)
  notes              String?
  /// DISPONIBILIDADE NA COTAÇÃO. `false` (o padrão) cobre dois casos que o
  /// preço distingue sozinho: item ainda não cotado (`estimatedUnitPrice`
  /// nulo) e item cotado (com preço). `true` é o terceiro estado, o que não
  /// existia: Compras procurou e o fornecedor NÃO TEM.
  ///
  /// Precisa ser explícito porque preço nulo já significa "ninguém cotou
  /// ainda", e preço zero significa brinde/bonificação (ver
  /// `purchase-order-form-schema.ts`). Nenhum dos dois pode ser reaproveitado
  /// para dizer "não tem" sem tornar o dado ambíguo.
  ///
  /// Item indisponível NÃO entra no total estimado e NÃO some da solicitação:
  /// a linha continua íntegra e pode virar item de ordem de compra de outro
  /// fornecedor depois (ver `PurchaseOrderItem`).
  unavailable        Boolean      @default(false)
  /// Por que o fornecedor não tem ("sem estoque", "fora de linha"). Opcional,
  /// e só faz sentido com `unavailable = true` — o service limpa quando o
  /// item volta a disponível.
  ///
  /// Separado de `notes` de propósito: `notes` é a observação de QUEM PEDIU e
  /// aparece como tal na tela; sobrescrevê-la com um recado de Compras
  /// apagaria o que o solicitante escreveu.
  unavailabilityNote String?
  /// DESCONTO DESTA LINHA, aplicado sobre `quantidade × preço unitário`.
  ///
  /// Só existe em item disponível e cotado: sem preço não há base sobre a
  /// qual descontar, e item que o fornecedor não tem está fora da conta
  /// inteira (regra C-16). O service limpa o desconto nos dois casos.
  discountType       DiscountType @default(AMOUNT)
  discountValue      Decimal      @default(0) @db.Decimal(14, 2)
  /// A DESCRIÇÃO NORMALIZADA para busca: minúsculas, sem acento, sem espaço
  /// nas pontas. É o que o autocomplete consulta — nunca `description`.
  ///
  /// Existe como COLUNA, e não como expressão no índice, por dois motivos. O
  /// Prisma não modela índice sobre expressão, então um `CREATE INDEX ... ON
  /// (lower(...))` viraria drift em todo `migrate dev` seguinte. E uma coluna
  /// pode ser indexada de DUAS formas ao mesmo tempo — btree para prefixo,
  /// GIN trigram para trecho no meio —, que é o que faz a busca responder
  /// desde a PRIMEIRA letra: um trigram não indexa padrão com menos de três
  /// caracteres, e `LIKE 'c%'` sem btree varreria a tabela.
  ///
  /// `description` continua intocada: é o que a pessoa digitou e o que o
  /// documento imprime. Esta coluna é derivada dela, gravada pelo service
  /// (ver `normalizeForSearch`), nunca informada pelo cliente.
  searchKey          String       @default("")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  purchaseRequest    PurchaseRequest     @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  /// Uma linha da solicitação pode virar VÁRIAS linhas de ordem — é assim que
  /// a compra parcelada entre fornecedores/entregas aparece no modelo (a
  /// SOL-0005 do staging já gerou duas ordens). Ver `PurchaseOrderItem`.
  purchaseOrderItems PurchaseOrderItem[]

  @@index([purchaseRequestId])
  /// DOIS índices sobre `searchKey`, e cada um serve a um tipo de busca:
  ///
  ///   btree text_pattern_ops   `LIKE 'ci%'`  — PREFIXO, e vale já na 1ª letra
  ///   GIN gin_trgm_ops         `LIKE '%ci%'` — TRECHO NO MEIO, a partir de 3
  ///
  /// Os dois são necessários. O trigram sozinho não atende "digite C e veja
  /// sugestões": ele não indexa padrão com menos de três caracteres, e o
  /// planejador cai em varredura sequencial exatamente nas duas primeiras
  /// teclas — as mais usadas. O btree sozinho não acha "cimento" quando se
  /// digita "mento".
  ///
  /// `text_pattern_ops` e não o btree padrão: com collation diferente de C, o
  /// operador `LIKE` só usa o índice com esta classe.
  @@index([searchKey(ops: raw("text_pattern_ops"))], map: "PurchaseRequestItem_searchKey_prefix_idx")
  @@index([searchKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "PurchaseRequestItem_searchKey_trgm_idx")
}

/// Pedido de compra emitido a um fornecedor a partir de uma requisição
/// aprovada. `constructionSiteId`/`costCenterId` são copiados da requisição
/// no momento da criação (não são escolhidos de novo pelo usuário).
model PurchaseOrder {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @db.Uuid
  purchaseRequestId    String              @db.Uuid
  supplierId           String              @db.Uuid
  /// Copiado da solicitação de origem — nulo quando o centro de custo dela não
  /// pertence a nenhuma obra. Ver a nota em `PurchaseRequest.constructionSiteId`.
  constructionSiteId   String?             @db.Uuid
  /// OPCIONAL, como na solicitação e como na fatura e na conta a pagar que
  /// vêm depois — a ordem era a única estrita no meio de uma cadeia que
  /// tolera nulo dos dois lados, e isso obrigava Compras a inventar uma
  /// atribuição de custo só para conseguir emitir.
  ///
  /// Quando vem, continua tendo de pertencer à obra da solicitação: centro de
  /// custo de outra obra somaria despesa no lugar errado.
  costCenterId         String?             @db.Uuid
  code                 String
  status               PurchaseOrderStatus @default(OPEN)
  /// DESCONTO GERAL DA ORDEM, sobre o subtotal já líquido dos descontos de
  /// item — a mesma ordem de operações da cotação (ver `discount.ts`).
  ///
  /// Existe porque o desconto NEGOCIADO na solicitação precisa chegar ao
  /// documento que vai ao fornecedor. Antes, a ordem nascia com o preço bruto
  /// e ficava acima do que foi acordado, sem nada na tela explicando a
  /// diferença.
  ///
  /// É COPIADO da solicitação ao gerar, e editável depois: a ordem é um
  /// documento próprio, e o comprador pode ter renegociado. Copiar sem deixar
  /// editar transformaria a cotação em contrato.
  discountType         DiscountType        @default(AMOUNT)
  discountValue        Decimal             @default(0) @db.Decimal(14, 2)
  /// LÍQUIDO: Σ(líquido das linhas) − desconto geral. Continua sendo o número
  /// que a alçada e o financeiro usam — o que mudou é que agora ele reflete o
  /// negociado, e não o de tabela.
  totalAmount          Decimal             @db.Decimal(14, 2)
  issueDate            DateTime
  expectedDeliveryDate DateTime?
  /// QUEM EMITIU a ordem. É o nome que assina o PDF — sem ele, o documento
  /// que vai ao fornecedor não diz de quem partiu o pedido.
  ///
  /// Opcional porque as ordens anteriores a este campo não têm autor, e
  /// atribuí-las a alguém seria inventar uma assinatura. Nelas o PDF imprime a
  /// linha sem nome, que é o que um documento em branco para assinar à mão
  /// sempre foi.
  createdById          String?             @db.Uuid
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  company          Company           @relation(fields: [companyId], references: [id])
  purchaseRequest  PurchaseRequest   @relation(fields: [purchaseRequestId], references: [id])
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  constructionSite ConstructionSite? @relation(fields: [constructionSiteId], references: [id])
  costCenter       CostCenter?       @relation(fields: [costCenterId], references: [id])
  createdBy        User?             @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])

  items           PurchaseOrderItem[]
  invoices        Invoice[]
  inboundInvoices InboundInvoice[]

  @@unique([companyId, code])
  @@index([supplierId])
  @@index([status])
  @@index([purchaseRequestId])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "PurchaseOrder_code_trgm_idx")
}

/// Item de linha de uma ordem de compra — o que foi REALMENTE pedido ao
/// fornecedor, linha a linha.
///
/// Antes disto a ordem tinha só `totalAmount`: um número digitado à mão, sem
/// nada que dissesse o que ele comprou. A cadeia de rastreabilidade morria na
/// solicitação, e uma solicitação que virava duas ordens não tinha como
/// informar qual parte coube a cada uma.
///
/// `purchaseRequestItemId` é OBRIGATÓRIO: é ele — e não o `purchaseRequestId`
/// da ordem — que amarra a linha comprada à linha pedida. O vínculo por
/// documento diria "esta ordem veio daquela solicitação"; só o vínculo por
/// item diz "estes 50 sacos de cimento são aqueles 50 sacos de cimento".
/// Comprar algo que ninguém pediu não tem caminho neste modelo, e isso é
/// deliberado nesta etapa (ver `docs/plano-evolucoes.md`).
model PurchaseOrderItem {
  id                    String @id @default(uuid()) @db.Uuid
  purchaseOrderId       String @db.Uuid
  purchaseRequestItemId String @db.Uuid

  /// COPIADOS da linha de origem no momento da criação, não lidos por
  /// travessia. A ordem é um documento que foi enviado a um fornecedor: o que
  /// ela diz precisa continuar valendo mesmo que a solicitação seja editada
  /// depois. Mesmo motivo pelo qual `InboundInvoice` guarda o emitente como
  /// veio no XML em vez de apontar só para o cadastro.
  description String
  unit        String

  /// A quantidade COMPRADA, que não é necessariamente a solicitada. Pedir 100
  /// e comprar 80 (o resto em outra ordem, ou nunca) é compra parcial, e o
  /// modelo precisa aceitá-la — o controle de saldo da solicitação é etapa
  /// posterior, mas o dado que ele vai precisar nasce aqui.
  quantity      Decimal      @db.Decimal(12, 3)
  /// Preço NEGOCIADO com o fornecedor. Nasce sugerido pela cotação
  /// (`PurchaseRequestItem.estimatedUnitPrice`) e pode divergir dela — a
  /// cotação é estimativa, esta é a compra.
  unitPrice     Decimal      @db.Decimal(14, 2)
  /// DESCONTO DESTA LINHA, sobre `quantity × unitPrice`. Copiado da linha
  /// correspondente da solicitação ao gerar a ordem, e editável depois.
  ///
  /// Guardado como o usuário informou (reais ou percentual) em vez de já
  /// resolvido em reais: o documento precisa poder dizer "10% de desconto",
  /// e um percentual convertido na gravação vira um valor que ninguém
  /// reconhece se a quantidade mudar depois.
  discountType  DiscountType @default(AMOUNT)
  discountValue Decimal      @default(0) @db.Decimal(14, 2)
  /// `quantity × unitPrice − desconto da linha`, calculado pelo backend e
  /// nunca aceito do cliente. Materializado (em vez de calculado na leitura)
  /// porque é o que os relatórios somam; se fosse derivado na consulta, cada
  /// soma pagaria a conta de novo e o arredondamento poderia divergir entre
  /// telas.
  ///
  /// Era `quantity × unitPrice` puro antes de a ordem ter desconto. As linhas
  /// antigas continuam corretas: desconto zero deixa a conta idêntica.
  totalPrice    Decimal      @db.Decimal(14, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrder       PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  /// `Restrict`: apagar de verdade uma linha de solicitação que já virou
  /// compra deixaria a ordem sem origem — exatamente a perda que este model
  /// existe para impedir. Na prática nunca dispara (a solicitação usa
  /// exclusão lógica, e só é editável em DRAFT, antes de existir ordem), é a
  /// rede para quem apagar por fora.
  purchaseRequestItem PurchaseRequestItem @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Restrict)

  /// A mesma linha da solicitação não entra duas vezes na MESMA ordem — seria
  /// duplicata, não compra parcial. Entre ordens diferentes ela pode repetir,
  /// e é isso que permite dividir um pedido em várias compras.
  @@unique([purchaseOrderId, purchaseRequestItemId])
  @@index([purchaseOrderId])
  @@index([purchaseRequestItemId])
}

