// RH
// =============================================================================

/// Funcionário (folha de pagamento / mão de obra própria).
model Employee {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @db.Uuid
  name            String
  cpf             String
  position        String
  status          EmployeeStatus @default(ACTIVE)
  hireDate        DateTime
  terminationDate DateTime?
  baseSalary      Decimal?       @db.Decimal(14, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  company           Company              @relation(fields: [companyId], references: [id])
  allocations       EmployeeAllocation[]
  timeEntries       TimeEntry[]
  productionEntries ProductionEntry[]
  payslips          Payslip[]
  bankAccounts      BankAccount[]

  @@unique([companyId, cpf])
  @@index([companyId])
  @@index([status])
  @@index([position])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Employee_name_trgm_idx")
  @@index([cpf(ops: raw("gin_trgm_ops"))], type: Gin, map: "Employee_cpf_trgm_idx")
  @@index([position(ops: raw("gin_trgm_ops"))], type: Gin, map: "Employee_position_trgm_idx")
}

/// Alocação de um funcionário em uma obra/centro de custo por período.
/// A alocação "atual" de um funcionário é a de maior startDate sem endDate
/// (ou com endDate futuro) — não há um campo de status dedicado.
model EmployeeAllocation {
  id                 String    @id @default(uuid()) @db.Uuid
  employeeId         String    @db.Uuid
  constructionSiteId String    @db.Uuid
  costCenterId       String?   @db.Uuid
  startDate          DateTime
  endDate            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  employee         Employee         @relation(fields: [employeeId], references: [id])
  constructionSite ConstructionSite @relation(fields: [constructionSiteId], references: [id])
  costCenter       CostCenter?      @relation(fields: [costCenterId], references: [id])

  @@index([employeeId])
  @@index([constructionSiteId])
}

/// Apontamento de ponto (entrada/saída) de um funcionário. `status` e
/// `hoursWorked` são derivados de checkIn/checkOut pelo backend, nunca
/// setados à mão pelo cliente da API.
model TimeEntry {
  id                 String          @id @default(uuid()) @db.Uuid
  employeeId         String          @db.Uuid
  constructionSiteId String?         @db.Uuid
  date               DateTime        @db.Date
  checkIn            DateTime?
  checkOut           DateTime?
  hoursWorked        Decimal?        @db.Decimal(5, 2)
  status             TimeEntryStatus @default(OPEN)
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  employee         Employee          @relation(fields: [employeeId], references: [id])
  constructionSite ConstructionSite? @relation(fields: [constructionSiteId], references: [id])

  @@index([employeeId, date])
  @@index([constructionSiteId, date])
}

/// Apontamento de produção/produtividade de um funcionário na obra
/// (ex.: m² de alvenaria executados no dia).
model ProductionEntry {
  id                 String    @id @default(uuid()) @db.Uuid
  employeeId         String    @db.Uuid
  constructionSiteId String    @db.Uuid
  costCenterId       String?   @db.Uuid
  date               DateTime  @db.Date
  description        String
  quantity           Decimal   @db.Decimal(12, 3)
  unit               String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  employee         Employee         @relation(fields: [employeeId], references: [id])
  constructionSite ConstructionSite @relation(fields: [constructionSiteId], references: [id])
  costCenter       CostCenter?      @relation(fields: [costCenterId], references: [id])

  @@index([employeeId, date])
  @@index([constructionSiteId, date])
}

/// Holerite mensal do funcionário. Editável enquanto `paidAt` estiver vazio;
/// uma vez marcado como pago, o registro trava (correções geram um novo
/// registro em vez de sobrescrever o anterior). O PDF é anexado via o model
/// genérico `Attachment` (entityType="Payslip").
model Payslip {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @db.Uuid
  referenceYear  Int
  referenceMonth Int
  grossSalary    Decimal   @db.Decimal(14, 2)
  deductions     Decimal   @db.Decimal(14, 2)
  netSalary      Decimal   @db.Decimal(14, 2)
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, referenceYear, referenceMonth])
  @@index([employeeId])
}

// =============================================================================
// TERCEIROS
// =============================================================================

/// Terceiro/subempreiteiro (prestador de serviço de mão de obra).
/// Modelado separado de Supplier por domínio de negócio (RH terceirizado vs.
/// fornecimento de materiais), mesmo que na prática possam ser a mesma pessoa
/// jurídica em alguns casos.
model Contractor {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  legalName       String
  tradeName       String?
  document        String // CNPJ ou CPF
  specialty       String?
  responsibleName String?
  status          ContractorStatus @default(ACTIVE)
  email           String?
  phone           String?
  city            String?
  state           String?          @db.VarChar(2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  company      Company              @relation(fields: [companyId], references: [id])
  contracts    ContractorContract[]
  bankAccounts BankAccount[]

  @@unique([companyId, document])
  @@index([companyId])
  @@index([status])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([legalName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contractor_legalName_trgm_idx")
  @@index([tradeName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contractor_tradeName_trgm_idx")
  @@index([document(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contractor_document_trgm_idx")
}

/// Contrato de terceirização entre a empresa e um Contractor para uma obra.
/// `status` só registra encerramento manual (antes do prazo) — o badge
/// vigente/vencendo/encerrado exibido na tela combina isto com `endDate`
/// (ver ContractorContractsService.withComputedStatus).
model ContractorContract {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String         @db.Uuid
  contractorId       String         @db.Uuid
  constructionSiteId String         @db.Uuid
  code               String
  scope              String
  totalValue         Decimal        @db.Decimal(14, 2)
  startDate          DateTime
  endDate            DateTime
  status             ContractStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  company          Company          @relation(fields: [companyId], references: [id])
  contractor       Contractor       @relation(fields: [contractorId], references: [id])
  constructionSite ConstructionSite @relation(fields: [constructionSiteId], references: [id])

  documents ContractDocument[]
  employees ContractEmployee[]

  @@unique([companyId, code])
  @@index([contractorId])
  @@index([constructionSiteId])
  @@index([endDate])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "ContractorContract_code_trgm_idx")
}

/// Documento obrigatório vinculado a um contrato de terceirização (ex.:
/// apólice de seguro, ART, certidões). O arquivo em si é anexado via o
/// model genérico `Attachment` (entityType="ContractDocument"), mesmo
/// padrão já usado pelo holerite do módulo de RH.
model ContractDocument {
  id         String    @id @default(uuid()) @db.Uuid
  contractId String    @db.Uuid
  name       String
  issueDate  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  contract ContractorContract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@index([expiresAt])
}

/// Funcionário da empresa terceirizada alocado num contrato específico
/// (distinto de `Employee`, que é mão de obra própria — ver módulo de RH).
model ContractEmployee {
  id         String    @id @default(uuid()) @db.Uuid
  contractId String    @db.Uuid
  name       String
  role       String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  contract ContractorContract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "ContractEmployee_name_trgm_idx")
}

// =============================================================================
// DADOS BANCÁRIOS
// =============================================================================

/// Conta bancária de quem RECEBE dinheiro da empresa.
///
/// ## Por que uma tabela própria, e não colunas em `User`
///
/// O ERP tem três entidades de pessoa e elas não são intercambiáveis:
/// `User` é um login, `Employee` é o funcionário CLT que recebe holerite e
/// `Contractor` é o terceirizado que recebe por contrato. Guardar a conta no
/// `User` deixaria o pedreiro — que não tem login — sem onde receber, e daria
/// um campo de conta ao contador externo, que nunca será pago por aqui.
///
/// ## Arco exclusivo
///
/// Exatamente UM dos três donos é preenchido, garantido por CHECK no banco
/// (`num_nonnulls(...) = 1`, ver a migration) e não só por validação da
/// aplicação: um bug de service não pode produzir uma conta órfã ou de dois
/// donos. A alternativa (`ownerType` + `ownerId` polimórfico) abriria mão da
/// integridade referencial — foi recusada por isso.
///
/// Hoje só a tela de Administração > Usuários escreve aqui. As colunas de
/// `Employee` e `Contractor` já existem para que RH e Terceiros liguem as
/// telas deles sem migration nova — nenhum fluxo de pagamento foi antecipado.
///
/// ## O que é cifrado e o que não é
///
/// Número da conta e chave PIX são cifrados com AES-256-GCM
/// (`BANK_DATA_ENCRYPTION_KEY`, ver `common/crypto`). Banco, agência e tipo de
/// conta ficam em texto: sozinhos não pagam ninguém, e é por eles que se
/// procura uma conta na tela.
///
/// A forma MASCARADA é gravada em coluna própria em vez de derivada na
/// leitura. Dois motivos: a listagem não precisa decifrar nada (a chave só é
/// usada quando alguém revela de fato), e uma troca de chave — que torna o
/// texto cifrado ilegível — não apaga a tela: o usuário continua vendo
/// `****1234` e sabe qual conta é.
model BankAccount {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  /// Arco exclusivo: um, e apenas um, destes três.
  userId       String? @db.Uuid
  employeeId   String? @db.Uuid
  contractorId String? @db.Uuid

  /// Código COMPE de 3 dígitos (001 Banco do Brasil, 341 Itaú, 260 Nu Pagamentos).
  /// Não há tabela de bancos no projeto e nenhuma foi criada: manter uma lista
  /// oficial atualizada é trabalho recorrente, e a conferência de verdade
  /// acontece no banco na hora de pagar. O nome vem digitado junto, para a
  /// tela não depender de um catálogo que não existe.
  bankCode String @db.VarChar(3)
  bankName String

  /// Agência sem o dígito, que vem à parte porque nem todo banco tem um.
  branch      String  @db.VarChar(6)
  branchDigit String? @db.VarChar(1)

  accountType BankAccountType

  /// `iv:authTag:ciphertext` em hex — mesmo formato do cofre fiscal.
  accountNumber       String
  /// `****1234`. É o que a tela mostra por padrão.
  accountNumberMasked String
  /// Dígito verificador da conta. Fica em texto porque, sem o número, um
  /// dígito sozinho não identifica nem revela conta nenhuma — e a máscara
  /// precisa dele para o usuário reconhecer a própria conta.
  accountDigit        String? @db.VarChar(1)

  /// PIX é opcional e independente da conta tradicional: as duas formas
  /// coexistem, e muita gente tem só uma delas.
  pixKeyType   PixKeyType?
  pixKey       String?
  pixKeyMasked String?

  /// Preenchidos SOMENTE quando o titular não é o dono da conta (pagamento
  /// para a esposa, para a MEI do prestador). Nulos = o titular é o próprio
  /// dono, e nome e documento são lidos do cadastro dele na hora de exibir —
  /// não duplicados aqui.
  ///
  /// Exceção documentada: quando o dono é um `User`, não há CPF no cadastro
  /// (o `User` do ERP guarda nome, e-mail, telefone e cargo — nunca documento).
  /// Nesse caso o documento do titular fica mesmo em branco, e é o `Employee`
  /// correspondente que carrega o CPF quando ele existir.
  holderName     String?
  /// Só dígitos, como todo documento do sistema (ver `document.util.ts`).
  holderDocument String? @db.VarChar(14)

  /// Desativar substitui excluir. Uma conta que já pagou alguém é histórico
  /// financeiro: apagá-la deixaria pagamento sem destino rastreável. Não há
  /// endpoint de exclusão — nem `deletedAt`, que seria uma segunda forma de
  /// dizer a mesma coisa.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee   Employee?   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractor Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([employeeId])
  @@index([contractorId])
}

// =============================================================================
// FINANCEIRO
// =============================================================================

/// Nota fiscal emitida por um fornecedor — origem das parcelas de contas a
/// pagar. Nasce sempre vinculada a uma ordem de compra (cadeia
/// PurchaseOrder -> Invoice -> AccountPayable -> Payment); obra e centro de
/// custo são copiados da ordem no momento da criação.
model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  companyId          String        @db.Uuid
  supplierId         String        @db.Uuid
  /// OPCIONAL desde 2026-08-06. Era obrigatório porque toda nota deveria
  /// nascer de uma compra aprovada — o que é verdade para compra planejada,
  /// mas não para compra de balcão: o fornecedor emite a nota na loja e não
  /// existe ordem nenhuma no sistema. Exigir a ordem ali significava que a
  /// nota simplesmente não podia virar conta a pagar.
  ///
  /// Quando nulo, `costCenterId` passa a ser a informação que diz A QUEM a
  /// despesa pertence — ver `InboundInvoicesService.reconcile`.
  purchaseOrderId    String?       @db.Uuid
  constructionSiteId String?       @db.Uuid
  costCenterId       String?       @db.Uuid
  number             String
  series             String?
  issueDate          DateTime
  totalAmount        Decimal       @db.Decimal(14, 2)
  status             InvoiceStatus @default(RECEIVED)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  company          Company           @relation(fields: [companyId], references: [id])
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  purchaseOrder    PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  constructionSite ConstructionSite? @relation(fields: [constructionSiteId], references: [id])
  costCenter       CostCenter?       @relation(fields: [costCenterId], references: [id])

  accountsPayable AccountPayable[]
  inboundInvoices InboundInvoice[]

  @@unique([supplierId, series, number])
  @@index([companyId])
  @@index([status])
  @@index([purchaseOrderId])
  @@index([issueDate])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "Invoice_number_trgm_idx")
}

/// Parcela de contas a pagar gerada ao validar uma nota fiscal. `status` é
/// recalculado a cada mudança nos pagamentos vinculados (soma dos pagamentos
/// PAID vs. `amount`) — nunca setado à mão pelo cliente da API.
model AccountPayable {
  id        String               @id @default(uuid()) @db.Uuid
  companyId String               @db.Uuid
  /// OPCIONAL desde 2026-08-23. Era obrigatório porque toda conta nascia de
  /// uma nota — verdade para compra com documento, falsa para a despesa que
  /// o Financeiro lança direto (aluguel, taxa, reembolso). Exigir a nota ali
  /// significava que a despesa simplesmente não podia entrar no sistema.
  ///
  /// Continua sendo o vínculo com o documento quando ele existe; quem diz
  /// COMO a conta nasceu é `origin`, não a presença deste campo.
  invoiceId String?              @db.Uuid
  origin    AccountPayableOrigin
  dueDate   DateTime
  amount    Decimal              @db.Decimal(14, 2)
  status    AccountPayableStatus @default(OPEN)

  /// A QUEM se deve. Materializado na própria conta, e não lido pela nota,
  /// porque agora existem contas sem nota — e porque toda consulta do módulo
  /// (filtro, busca, listagem, relatório) precisa de UM caminho só para
  /// chegar ao fornecedor. Nas contas vindas de nota é uma cópia de
  /// `Invoice.supplierId`, que nunca muda depois de criada (não está em
  /// nenhum DTO de edição), então as duas não têm como divergir.
  supplierId String @db.Uuid

  /// A QUE a despesa pertence. Mesma regra que a solicitação de compra e a
  /// conciliação sem ordem já usam: o centro de custo é o destino informado,
  /// e a obra é DERIVADA dele — fica nula quando o centro é administrativo.
  /// Nulos nas contas criadas antes desta mudança; ver a nota de compatibilidade
  /// em `docs/conta-a-pagar-avulsa.md`.
  costCenterId       String? @db.Uuid
  constructionSiteId String? @db.Uuid

  /// O que a conta é, em uma linha. Obrigatório no lançamento manual (é a
  /// única identificação que ele tem); nulo nas contas vindas de nota, que
  /// se identificam pelo número dela.
  description    String?
  /// Número do documento que originou a despesa quando não é nota fiscal —
  /// recibo, contrato, fatura de concessionária. Texto livre de propósito:
  /// não é documento fiscal e não tem formato garantido.
  documentNumber String?
  issueDate      DateTime?
  /// Forma de pagamento PRETENDIDA, informada no lançamento. Não confundir
  /// com `Payment.method`, que registra como foi pago de fato.
  paymentMethod  PaymentMethod?
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company          Company           @relation(fields: [companyId], references: [id])
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  costCenter       CostCenter?       @relation(fields: [costCenterId], references: [id])
  constructionSite ConstructionSite? @relation(fields: [constructionSiteId], references: [id])

  payments  Payment[]
  bankSlips BankSlip[]

  @@index([invoiceId])
  @@index([dueDate])
  @@index([status])
  @@index([companyId])
  @@index([supplierId])
  @@index([costCenterId])
  @@index([origin])
}

/// Pagamento efetuado contra uma parcela de contas a pagar. Relação 1:N com
/// AccountPayable para suportar pagamentos parciais. Tem ciclo de vida
/// próprio (`status`) e soft delete, como as demais entidades do módulo —
/// só pagamentos com status PAID contam pro saldo quitado da parcela.
/// Boleto recebido do fornecedor.
///
/// Documento COMPLEMENTAR: ele não cria despesa e não substitui a origem da
/// conta a pagar. A conta continua nascendo de nota conciliada ou de
/// lançamento avulso, com a cadeia até a obra intacta; o boleto só diz por
/// qual papel aquela conta será paga.
///
/// ## Nada aqui paga nada
///
/// Vincular não é dar baixa. Pagamento continua sendo `Payment`, com as
/// permissões e o fluxo que já existiam.
///
/// ## Os campos extraídos são IMUTÁVEIS
///
/// Nenhum deles aparece em DTO de edição. Não é convenção, é estrutura: o que
/// foi lido do documento não pode ser "corrigido" silenciosamente para casar
/// com uma conta a pagar. As correções que existem moram em colunas PRÓPRIAS
/// (`supplierId` escolhido à mão quando o CNPJ não casou), então o valor
/// original continua legível ao lado da decisão de quem conferiu.
///
/// ## Duplicidade
///
/// A linha digitável É a identidade do boleto — dois arquivos diferentes do
/// mesmo título têm a mesma linha. Daí a unique por empresa. `fileHash` existe
/// para uma mensagem melhor ("este mesmo arquivo já foi enviado"), não como
/// chave: arquivo é o continente, a linha é o conteúdo.
model BankSlip {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  source BankSlipSource
  status BankSlipStatus @default(PENDING)

  /// SHA-256 do arquivo enviado. Nulo na digitação manual, que não tem arquivo.
  fileHash String? @db.VarChar(64)

  // ── Lido do documento, nunca editável ──────────────────────────────────
  /// 47 dígitos, sem máscara.
  digitableLine String    @db.VarChar(47)
  /// 44 dígitos, derivados da linha — guardado porque é o que um leitor de
  /// código de barras devolve, e a busca por ele precisa ser direta.
  barcode       String    @db.VarChar(44)
  bankCode      String    @db.VarChar(3)
  /// Nulo em boleto "sem valor" (quantia definida no pagamento). Distinto de
  /// "valor não identificado", que não existe: ou a linha digitável foi lida,
  /// e então o valor veio com ela, ou o boleto não entrou.
  amount        Decimal?  @db.Decimal(14, 2)
  /// Nulo quando o fator de vencimento é 0000 — boleto sem vencimento.
  dueDate       DateTime?

  /// Campos que só o texto do PDF traz, quando traz. Todos opcionais: a linha
  /// digitável não carrega beneficiário, e é ela que sustenta o resto.
  beneficiaryName     String?
  /// Só dígitos, como todo documento do sistema.
  beneficiaryDocument String?   @db.VarChar(14)
  documentNumber      String?
  ourNumber           String?
  issueDate           DateTime?

  // ── Decisões de quem conferiu ──────────────────────────────────────────
  /// Fornecedor identificado pelo CNPJ do beneficiário ou escolhido à mão.
  /// Nulo enquanto ninguém resolveu. NÃO é criado automaticamente: cadastrar
  /// fornecedor a partir de um boleto criaria cadastro que ninguém conferiu.
  supplierId             String? @db.Uuid
  /// Ligado quando o fornecedor foi escolhido por uma pessoa, e não pelo CNPJ.
  /// A distinção importa na auditoria: uma é leitura, a outra é decisão.
  supplierChosenManually Boolean @default(false)

  accountPayableId String?   @db.Uuid
  linkedAt         DateTime?
  linkedById       String?   @db.Uuid

  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  accountPayable AccountPayable? @relation(fields: [accountPayableId], references: [id])
  uploadedBy     User            @relation("BankSlipUploadedBy", fields: [uploadedById], references: [id])
  linkedBy       User?           @relation("BankSlipLinkedBy", fields: [linkedById], references: [id])

  /// A identidade do boleto, por empresa. É o que impede o mesmo título de
  /// entrar duas vezes e virar pagamento em dobro.
  @@unique([companyId, digitableLine])
  @@index([companyId, status])
  @@index([accountPayableId])
  @@index([supplierId])
  @@index([dueDate])
}

model Payment {
  id               String              @id @default(uuid()) @db.Uuid
  accountPayableId String              @db.Uuid
  amount           Decimal             @db.Decimal(14, 2)
  paidAt           DateTime
  method           String?
  status           PaymentRecordStatus @default(PENDING)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  accountPayable AccountPayable @relation(fields: [accountPayableId], references: [id], onDelete: Cascade)

  @@index([accountPayableId])
  @@index([paidAt])
}

// =============================================================================
// GERAL
// =============================================================================

/// Anexo genérico associado a qualquer entidade do sistema (associação
/// polimórfica via entityType/entityId, sem FK física para permitir anexar
/// arquivos a qualquer model presente ou futuro sem alterar este schema).
model Attachment {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  entityType   String // nome do model relacionado, ex.: "PurchaseRequest", "Invoice"
  entityId     String    @db.Uuid
  fileName     String
  fileUrl      String
  mimeType     String
  sizeBytes    Int?
  uploadedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company    Company @relation(fields: [companyId], references: [id])
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([companyId])
}

/// Log de auditoria — registro imutável de ações relevantes no sistema.
/// Nunca recebe soft delete; `userId` fica nulo (via SetNull) se o usuário
/// autor for removido, preservando o histórico.
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  companyId  String      @db.Uuid
  userId     String?     @db.Uuid
  action     AuditAction
  entityType String
  entityId   String      @db.Uuid
  ipAddress  String?
  changes    Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

/// Comentário associado a qualquer entidade do sistema, mesma associação
/// polimórfica (entityType/entityId) usada por Attachment — módulo de
/// Workflow (ver apps/api/src/workflow) é o único escritor hoje.
model WorkflowComment {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  entityType String
  entityId   String    @db.Uuid
  authorId   String    @db.Uuid
  body       String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])

  @@index([entityType, entityId])
  @@index([companyId])
}

/// Parâmetros gerais do ERP — uma linha por empresa (1:1), criada sob demanda
/// com defaults na primeira leitura (ver SystemSettingsService.getOrCreate).
/// `notificationsEnabled`/`auditEnabled`/`allowAttachments`/`maxUploadSizeMb`
/// são preferências armazenadas aqui; nenhum outro módulo lê/aplica esses
/// valores ainda (ver notas de evolução futura).
model SystemSettings {
  id                        String        @id @default(uuid()) @db.Uuid
  companyId                 String        @unique @db.Uuid
  /// Como o cliente chama o sistema. O padrão é neutro de propósito: o produto
  /// não nasce com o nome de nenhum cliente. Cada empresa renomeia em
  /// Configurações → Sistema, e a interface usa o nome do produto enquanto
  /// isso não acontecer.
  erpName                   String        @default("ERP")
  theme                     SettingsTheme @default(SYSTEM)
  language                  String        @default("pt-BR")
  timezone                  String        @default("America/Sao_Paulo")
  currency                  String        @default("BRL")
  dateFormat                String        @default("DD/MM/YYYY")
  firstDayOfWeek            Int           @default(0)
  dueDateAlertDays          Int           @default(7)
  /// Alçada de aprovação. `0` (padrão) mantém o comportamento antigo: sem
  /// alçada nenhuma. Acima de zero, aprovar uma solicitação de compra ou
  /// registrar um pagamento com valor MAIOR que este limite passa a exigir a
  /// permissão `<módulo>.approve`, além da de escrita.
  purchaseApprovalThreshold Decimal       @default(0) @db.Decimal(14, 2)
  paymentApprovalThreshold  Decimal       @default(0) @db.Decimal(14, 2)
  maxUploadSizeMb           Int           @default(10)
  allowAttachments          Boolean       @default(true)
  notificationsEnabled      Boolean       @default(true)
  auditEnabled              Boolean       @default(true)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

/// Preferência de canal de notificação por evento (catálogo fixo de eventos
/// definido em código — ver NOTIFICATION_EVENTS). `channelWhatsapp`/`channelPush`
/// existem só como estrutura preparatória: a interface os expõe desabilitados
/// e nenhuma integração real de envio existe ainda para nenhum canal.
model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  eventKey        String
  channelSystem   Boolean  @default(true)
  channelEmail    Boolean  @default(false)
  channelWhatsapp Boolean  @default(false)
  channelPush     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, eventKey])
}

// =============================================================================
// CONCILIAÇÃO DE NOTAS FISCAIS
// =============================================================================

/// Situação da nota recebida dentro do fluxo de conciliação. É DISTINTO de
/// `InvoiceStatus`: aquele descreve a nota já vinculada a uma ordem de compra
/// (o documento contábil), este descreve o documento que chegou e ainda pode
/// não virar nada.
enum InboundInvoiceStatus {
  PENDING
  RECONCILED
  DIVERGENT
  CANCELLED
}

/// Como o documento entrou no sistema. Hoje só `MANUAL` acontece de fato; os
/// outros dois existem para que a captura automática (importação de XML e
/// consulta à SEFAZ) entre depois sem migração de dados — a coluna já sabe
/// distinguir a origem de cada nota que já estiver na base.
enum InboundInvoiceSource {
  MANUAL
  XML_IMPORT
  SEFAZ
}

/// Forma de pagamento escolhida na geração financeira.
enum PaymentMethod {
  PIX
  CREDIT_CARD
  CASH
  BANK_SLIP
}

/// Condição de pagamento: quantas parcelas de `AccountPayable` a conciliação
/// gera e com que espaçamento. `NET_30_60_90` gera três parcelas, não uma.
enum PaymentTerms {
  CASH
  NET_30
  NET_30_60
  NET_30_60_90
}

/// Nota fiscal recebida, antes (e depois) da conciliação.
///
/// Existe separada de `Invoice` porque as duas respondem perguntas diferentes:
/// `Invoice` é a nota JÁ vinculada a uma ordem de compra — tem `purchaseOrderId`
/// obrigatório e é o que gera contas a pagar. Uma nota que acabou de chegar
/// ainda não tem ordem de compra nenhuma, pode nunca ter (nota indevida,
/// cancelada) e pode nem ser de um fornecedor cadastrado. Forçá-la dentro de
/// `Invoice` exigiria afrouxar aquele vínculo obrigatório, e aí o módulo
/// financeiro perderia a garantia de que toda conta a pagar nasce de uma
/// compra aprovada.
///
/// Por isso os dados do emitente ficam DESNORMALIZADOS aqui (`supplierName`,
/// `supplierDocument`): eles são o que veio no documento fiscal, não o que
/// está no cadastro. `supplierId` é preenchido quando o CNPJ casa com um
/// fornecedor conhecido — e continua nulo quando não casa, que é justamente
/// o caso em que o financeiro precisa ver a nota para agir.
model InboundInvoice {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  /// Emitente COMO VEIO no documento fiscal. Preservado mesmo depois de
  /// vincular o fornecedor: é a prova do que a nota dizia.
  supplierName     String
  supplierDocument String
  /// Nulo enquanto o CNPJ não casar com nenhum fornecedor cadastrado.
  supplierId       String? @db.Uuid

  number    String
  series    String?
  /// Chave de acesso da NF-e (44 dígitos). Opcional porque a entrada manual
  /// desta versão nem sempre a tem; é única quando informada, o que impede a
  /// mesma nota de entrar duas vezes quando a captura automática existir.
  accessKey String? @db.VarChar(44)

  issueDate   DateTime
  totalAmount Decimal  @db.Decimal(14, 2)

  /// Dados do emitente que só o documento COMPLETO traz — o resumo tem
  /// apenas razão social e IE. Ficam nulos enquanto só o resumo chegou.
  supplierTradeName String?
  supplierIe        String?
  supplierAddress   String?
  supplierCity      String?
  supplierState     String? @db.VarChar(2)
  supplierZipCode   String? @db.VarChar(8)

  /// Totais e impostos, todos do procNFe. `totalAmount` (vNF) já vem no
  /// resumo; os demais não.
  productsAmount Decimal? @db.Decimal(14, 2)
  freightAmount  Decimal? @db.Decimal(14, 2)
  discountAmount Decimal? @db.Decimal(14, 2)
  icmsAmount     Decimal? @db.Decimal(14, 2)
  ipiAmount      Decimal? @db.Decimal(14, 2)
  pisAmount      Decimal? @db.Decimal(14, 2)
  cofinsAmount   Decimal? @db.Decimal(14, 2)

  additionalInfo String?
  /// Protocolo de autorização da SEFAZ. É a prova de que o documento foi
  /// autorizado — substitui, para o nosso uso, revalidar a assinatura XML.
  protocolNumber String?

  /// Ligado quando o `procNFe` chegou. Enquanto for `false`, a nota tem só o
  /// cabeçalho do resumo e NÃO tem itens — a tela precisa dizer isso ao
  /// financeiro em vez de mostrar uma lista vazia como se a nota não tivesse
  /// produtos.
  hasFullDocument Boolean @default(false)

  /// Quando a nota foi cancelada pelo emitente (cSitNFe=3 no resumo ou evento
  /// 110111). Cancelada não entra na fila de conciliação.
  cancelledAt DateTime?

  status InboundInvoiceStatus @default(PENDING)
  source InboundInvoiceSource @default(MANUAL)

  /// Caminhos no storage. Nulos nesta versão (sem captura automática); a tela
  /// de conciliação já os exibe como indisponíveis quando faltam.
  xmlPath String?
  pdfPath String?

  /// Preenchidos na conciliação e nunca mais alterados — é o vínculo
  /// permanente entre a nota e a compra que a originou.
  purchaseOrderId String?   @db.Uuid
  /// A `Invoice` criada no ato da conciliação. É por ela que a nota alcança
  /// as contas a pagar, sem que este módulo precise escrever em `AccountPayable`
  /// por fora do caminho normal do financeiro.
  invoiceId       String?   @db.Uuid
  reconciledAt    DateTime?
  reconciledById  String?   @db.Uuid

  /// Escolhas da geração financeira, guardadas aqui porque `AccountPayable`
  /// não tem onde registrá-las e alterá-la sairia do escopo deste módulo.
  paymentMethod PaymentMethod?
  paymentTerms  PaymentTerms?
  notes         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company       Company        @relation(fields: [companyId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  /// `Restrict` nos dois: a conciliação é um vínculo permanente, e um
  /// `SET NULL` transformaria uma exclusão de ordem de compra em perda
  /// silenciosa de rastreabilidade. O sistema usa exclusão lógica em todo
  /// lugar, então na prática isto nunca dispara — é a rede de proteção para
  /// quando alguém apagar de verdade.
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reconciledBy  User?          @relation(fields: [reconciledById], references: [id])

  items      InboundInvoiceItem[]
  importLogs FiscalImportLog[]

  /// Mesma nota (emitente + série + número) não entra duas vezes.
  @@unique([companyId, supplierDocument, series, number])
  @@unique([accessKey])
  @@index([companyId])
  @@index([status])
  @@index([issueDate])
  @@index([supplierId])
  @@index([purchaseOrderId])
  /// Índices trigram para as buscas por texto (`contains` + `mode: insensitive`,
  /// que viram ILIKE). Sem eles o Postgres varre a tabela inteira a cada
  /// digitação no campo de busca — o custo só aparece quando a base cresce.
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "InboundInvoice_number_trgm_idx")
  @@index([supplierName(ops: raw("gin_trgm_ops"))], type: Gin, map: "InboundInvoice_supplierName_trgm_idx")
  @@index([supplierDocument(ops: raw("gin_trgm_ops"))], type: Gin, map: "InboundInvoice_supplierDocument_trgm_idx")
}

/// Item da nota recebida. Existe "quando disponível": a entrada manual pode
/// não trazer item nenhum, e a tela de conciliação lida com a lista vazia.
model InboundInvoiceItem {
  id               String  @id @default(uuid()) @db.Uuid
  inboundInvoiceId String  @db.Uuid
  /// Número do item dentro da nota (`nItem`). Preserva a ordem original do
  /// documento fiscal, que é a ordem em que o financeiro confere.
  itemNumber       Int?
  /// Código do produto no catálogo do EMITENTE (`cProd`) — não é o nosso.
  code             String?
  description      String
  unit             String?
  quantity         Decimal @db.Decimal(14, 4)
  unitPrice        Decimal @db.Decimal(14, 4)
  totalPrice       Decimal @db.Decimal(14, 2)
  /// Classificação fiscal. Nulos quando o item veio de lançamento manual.
  ncm              String? @db.VarChar(8)
  cfop             String? @db.VarChar(4)
  cst              String? @db.VarChar(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inboundInvoice InboundInvoice @relation(fields: [inboundInvoiceId], references: [id], onDelete: Cascade)

  @@index([inboundInvoiceId])
}

// =============================================================================
// INTEGRAÇÃO FISCAL (Distribuição DF-e)
// =============================================================================

/// Resultado de uma execução da sincronização.
enum FiscalSyncStatus {
  SUCCESS
  /// Trouxe documentos, mas ainda há mais na fila (`ultNSU < maxNSU`).
  PARTIAL
  /// Nada novo — é o caso mais comum e NÃO é erro.
  EMPTY
  /// Não chegou a consultar: sem certificado, ou dentro do bloqueio de 1h.
  SKIPPED
  ERROR
}

enum FiscalSyncTrigger {
  SCHEDULED
  MANUAL
}

/// Situação do documento dentro do pipeline. Esta sprint só consulta, baixa,
/// persiste e ENCAMINHA — a leitura do XML é da sprint seguinte, e é por isso
/// que `PENDING` e `FORWARDED` existem separados de `PROCESSED`.
enum FiscalDocumentStatus {
  PENDING
  FORWARDED
  PROCESSED
  ERROR
}

/// O que o documento é, derivado do atributo `schema` que a SEFAZ envia —
/// não da leitura do conteúdo. É a única classificação feita nesta sprint.
enum FiscalDocumentType {
  NFE_COMPLETA
  RESUMO_NFE
  EVENTO_COMPLETO
  RESUMO_EVENTO
  DESCONHECIDO
}

/// Certificado digital A1 da empresa.
///
/// O `.pfx` E a senha ficam CIFRADOS (AES-256-GCM, chave em
/// `FISCAL_CERT_ENCRYPTION_KEY`). Guardar a senha em texto puro entregaria a
/// identidade jurídica da empresa a quem lesse uma linha do banco: com o par
/// arquivo+senha é possível assinar e emitir documento fiscal em nome dela.
///
/// Os campos de identificação (`cnpj`, `subjectName`, validade) são extraídos
/// do certificado no upload e guardados em claro DE PROPÓSITO: o painel
/// precisa exibi-los e alertar sobre vencimento sem decifrar nada.
model FiscalCertificate {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @unique @db.Uuid

  /// Conteúdo do .pfx cifrado. `Bytes` e não `String`: é binário, e
  /// base64 no meio do caminho só aumentaria o tamanho.
  encryptedPfx      Bytes
  /// Senha cifrada, no formato `iv:authTag:ciphertext` (hex).
  encryptedPassword String

  /// Extraídos do certificado no upload — nunca informados pelo usuário.
  cnpj         String   @db.VarChar(14)
  subjectName  String
  issuerName   String
  serialNumber String
  notBefore    DateTime
  notAfter     DateTime

  /// Desligar sem apagar: mantém a rastreabilidade de qual certificado estava
  /// em uso em cada sincronização passada.
  isActive Boolean @default(true)

  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company @relation(fields: [companyId], references: [id])
  uploadedBy User?   @relation(fields: [uploadedById], references: [id])

  @@index([companyId])
}

/// Ponteiro da sincronização. Uma linha por empresa.
///
/// Separado de `FiscalCertificate` porque o ciclo de vida é outro: trocar o
/// certificado (renovação anual) NÃO pode reiniciar a leitura do zero —
/// pedir de `ultNSU=0` é tratado pela SEFAZ como consumo indevido.
model FiscalSyncState {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @unique @db.Uuid

  /// Último NSU efetivamente lido. 15 dígitos com zeros à esquerda.
  lastNSU String @default("000000000000000") @db.VarChar(15)
  /// Maior NSU que a SEFAZ informou existir. `lastNSU < maxNSU` significa
  /// que há mais páginas a buscar.
  maxNSU  String @default("000000000000000") @db.VarChar(15)

  lastSyncAt    DateTime?
  lastSuccessAt DateTime?
  totalImported Int       @default(0)

  /// Até quando NÃO se pode consultar. A SEFAZ bloqueia por 1 hora ao
  /// detectar consumo indevido (cStat 656) e CADA nova tentativa durante o
  /// bloqueio reinicia o relógio — então o job precisa se conter sozinho, ou
  /// uma execução horária transformaria uma hora de espera em bloqueio
  /// permanente.
  blockedUntil DateTime?
  blockReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

/// Histórico de sincronizações. Uma linha por execução, com ou sem sucesso.
model FiscalSyncRun {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  trigger FiscalSyncTrigger
  status  FiscalSyncStatus

  startedAt  DateTime
  finishedAt DateTime?
  durationMs Int?

  /// Retorno cru da SEFAZ, para diagnóstico posterior sem precisar reproduzir.
  cStat   String? @db.VarChar(3)
  xMotivo String?

  documentsFound    Int @default(0)
  documentsImported Int @default(0)
  /// Documentos que já existiam (mesma NSU) e foram ignorados. Separado de
  /// `imported` para que uma execução que não trouxe nada novo não pareça
  /// falha.
  documentsSkipped  Int @default(0)

  nsuFrom String? @db.VarChar(15)
  nsuTo   String? @db.VarChar(15)
  maxNSU  String? @db.VarChar(15)

  /// Mensagem já higienizada — nunca contém senha, conteúdo de certificado
  /// nem XML completo.
  errorMessage String?

  triggeredById String?  @db.Uuid
  createdAt     DateTime @default(now())

  company     Company @relation(fields: [companyId], references: [id])
  triggeredBy User?   @relation(fields: [triggeredById], references: [id])

  @@index([companyId, startedAt])
  @@index([status])
}

/// Documento fiscal como a SEFAZ entregou. É o arquivo ORIGINAL, sem
/// alteração: é ele que tem valor legal e precisa ser guardado por 5 anos.
///
/// O XML fica no banco (e não no storage de arquivos) por três razões: são
/// ~10 KB cada; precisam ser gravados na MESMA transação que o avanço do
/// ponteiro NSU, senão um arquivo perdido vira um documento que nunca mais
/// será oferecido pela SEFAZ; e a guarda legal exige durabilidade que o disco
/// local de uma instância não dá. Migrar para storage depois é trocar uma
/// coluna por uma chave.
model FiscalDocument {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  /// NSU é único por empresa — é o identificador do documento NA FILA.
  nsu    String             @db.VarChar(15)
  schema String
  type   FiscalDocumentType

  /// Chave de acesso (44 dígitos). NÃO é única de propósito: a mesma nota
  /// chega DUAS vezes em NSUs diferentes — primeiro como resumo, depois como
  /// documento completo (medido na POC em 2026-08-05). Quem consumir daqui
  /// deduplica por esta chave, preferindo o `NFE_COMPLETA`.
  accessKey String? @db.VarChar(44)

  /// O XML original, exatamente como veio (após o gunzip do docZip).
  xml Bytes

  status       FiscalDocumentStatus @default(PENDING)
  forwardedAt  DateTime?
  /// Preenchido pela sprint seguinte, quando o XML for interpretado.
  processedAt  DateTime?
  errorMessage String?

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company           @relation(fields: [companyId], references: [id])
  importLogs FiscalImportLog[]

  @@unique([companyId, nsu])
  @@index([companyId, status])
  @@index([accessKey])
  @@index([receivedAt])
}

/// Resultado da tentativa de transformar um documento fiscal em nota.
enum FiscalImportResult {
  /// Nota criada ou atualizada com sucesso.
  IMPORTED
  /// Documento reconhecido, mas sem efeito — evento que não é cancelamento,
  /// ou resumo que chegou depois do documento completo.
  SKIPPED
  /// Cancelamento aplicado a uma nota.
  CANCELLED
  FAILED
}

/// Log por documento processado. Uma linha por tentativa, com ou sem sucesso.
///
/// Existe separado de `FiscalSyncRun` porque as duas etapas falham por motivos
/// diferentes: a sincronização falha por rede, certificado ou bloqueio da
/// SEFAZ; a importação falha por XML fora do esperado. Misturar as duas faria
/// "10 documentos com erro" não distinguir "a SEFAZ está fora do ar" de "dez
/// notas com estrutura estranha".
model FiscalImportLog {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  fiscalDocumentId String @db.Uuid
  /// Origem: o schema do documento (`procNFe_v4.00`, `resNFe_v1.01`…) e o NSU.
  /// Guardados aqui porque o `FiscalDocument` pode ser expurgado no futuro e o
  /// log de importação precisa continuar explicando o que aconteceu.
  sourceSchema     String
  sourceNsu        String @db.VarChar(15)

  result       FiscalImportResult
  itemsCount   Int                @default(0)
  durationMs   Int
  /// Mensagem já higienizada — nunca contém o XML.
  errorMessage String?

  /// A nota resultante. Nulo quando o documento não gerou nota.
  inboundInvoiceId String? @db.Uuid

  createdAt DateTime @default(now())

  company        Company         @relation(fields: [companyId], references: [id])
  fiscalDocument FiscalDocument  @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)
  inboundInvoice InboundInvoice? @relation(fields: [inboundInvoiceId], references: [id])

  @@index([companyId, createdAt])
  @@index([result])
  @@index([fiscalDocumentId])
}

// =============================================================================
// DIÁRIO DE OBRAS
// =============================================================================

/// Relatório Diário de Obra (RDO). **Esqueleto deliberado**: aqui existem
/// apenas a identidade e o vínculo do relatório — obra, data, número, autor e
/// situação. Clima, mão de obra, equipamentos, atividades, ocorrências,
/// materiais, fotos, vídeos, PDF e assinaturas são as etapas seguintes do
/// Diário e ainda NÃO estão modelados; cada uma entra como tabela/coluna
/// própria, sem alterar o que está aqui.
///
/// Ele nasce nesta fundação, e não na etapa em que o preenchimento for
/// implementado, porque o controle de acesso precisa de algo para proteger: a
/// regra "não consigo ler o RDO de uma obra que não é minha" só é verificável
/// se o RDO existir como tabela.
///
/// `companyId` é redundante em relação à obra, ao contrário do que acontece em
/// `UserConstructionSite`: aqui ele existe para as listagens do Diário
/// filtrarem por inquilino sem um join obrigatório com `ConstructionSite` — o
/// mesmo padrão já usado por `Invoice` e `AccountPayable`. O service escreve
/// os dois a partir da obra, nunca do cliente.
model DailyReport {
  id                    String            @id @default(uuid()) @db.Uuid
  companyId             String            @db.Uuid
  constructionSiteId    String            @db.Uuid
  /// Sequencial POR OBRA, e não global: em campo o relatório é "o RDO 24 da
  /// Aurora", nunca "o RDO 1.842 do sistema".
  number                Int
  reportDate            DateTime          @db.Date
  status                DailyReportStatus @default(DRAFT)
  /// Observações gerais do dia. PRIMEIRO campo de conteúdo do RDO, e por
  /// enquanto o único: clima, mão de obra, equipamentos, atividades,
  /// ocorrências, materiais, fotos e vídeos são as etapas seguintes e entram
  /// como tabelas próprias.
  ///
  /// Ele existe agora porque o salvamento incremental (autosave) precisa de
  /// algo real para salvar: uma infraestrutura de autosave sem nenhum campo
  /// que a exercite não é infraestrutura, é código não executado.
  notes                 String?
  /// Horário de trabalho do dia, em MINUTOS desde a meia-noite (0–1439).
  ///
  /// Não é `DateTime`, e a diferença importa. Um horário de expediente não tem
  /// data nem fuso: "07:00" é sete da manhã na obra, e guardá-lo como
  /// timestamp obrigaria a inventar um dia e um fuso que não significam nada —
  /// e a errar em uma hora quando o servidor mudasse de zona. `TimeEntry`, no
  /// RH, usa `DateTime` porque lá o valor É um instante (a batida do ponto);
  /// aqui é uma hora do relógio.
  ///
  /// Inteiro também é o formato em que a conta futura sai de graça: horas
  /// trabalhadas no mês é uma soma, não um parse.
  ///
  /// Os quatro são opcionais de propósito — o RDO é preenchido ao longo do dia,
  /// e exigir o horário de término às 9h da manhã travaria o resto da tela.
  workStartMinutes      Int?
  workBreakStartMinutes Int?
  workBreakEndMinutes   Int?
  workEndMinutes        Int?
  scheduleNotes         String?
  /// Clima por período. Duas colunas, e não uma tabela filha com uma linha por
  /// período: são exatamente dois períodos, fixos, um por relatório. Uma tabela
  /// 1:1 aqui seria um join comprado sem nada em troca — e o PATCH do autosave,
  /// que já existe para `notes`, passa a cobrir clima sem nenhum mecanismo novo.
  ///
  /// (Se um dia os períodos virarem variáveis — noite, madrugada, faixas de
  /// hora —, aí sim a forma certa passa a ser uma tabela com `period`.)
  morningWeather        WeatherCondition?
  afternoonWeather      WeatherCondition?
  weatherNotes          String?
  /// De qual relatório este foi copiado. Responde "de onde veio este RDO"
  /// sem depender de auditoria, e é o gancho da tela ("copiado do RDO #23").
  /// Nulo em todo relatório começado do zero.
  copiedFromId          String?           @db.Uuid
  /// Quando o relatório foi finalizado, e por quem. Preenchidos SÓ na
  /// transição — nunca na criação, nunca por um PATCH.
  ///
  /// `createdAt` não serve para isso: um RDO aberto às 7h e finalizado às 17h
  /// tem dois instantes distintos, e o documento precisa dizer quando foi
  /// FECHADO, não quando foi aberto.
  ///
  /// Nulos enquanto é rascunho — e é essa nulidade que responde "este RDO já
  /// foi entregue?" sem depender de o enum estar correto.
  submittedAt           DateTime?
  submittedById         String?           @db.Uuid
  createdById           String            @db.Uuid
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  /// Herdado do padrão de soft delete do ERP e NUNCA escrito neste modelo: a
  /// exclusão de RDO é definitiva (ver o comentário da constraint de data
  /// abaixo). As consultas filtram `deletedAt: null` de propósito — se um dia
  /// existir arquivamento de relatório, ele já entra sem alterar leitura.
  deletedAt             DateTime?

  company          Company          @relation(fields: [companyId], references: [id])
  constructionSite ConstructionSite @relation(fields: [constructionSiteId], references: [id])
  createdBy        User             @relation(fields: [createdById], references: [id])
  submittedBy      User?            @relation("DailyReportSubmittedBy", fields: [submittedById], references: [id])
  copiedFrom       DailyReport?     @relation("DailyReportCopy", fields: [copiedFromId], references: [id])
  copies           DailyReport[]    @relation("DailyReportCopy")

  labor       DailyReportLabor[]
  equipment   DailyReportEquipment[]
  activities  DailyReportActivity[]
  occurrences DailyReportOccurrence[]
  materials   DailyReportMaterial[]
  media       DailyReportMedia[]

  @@unique([constructionSiteId, number])
  /// UM relatório por obra por dia. Não é regra inventada aqui: o modelo já
  /// dizia isso em três lugares — o nome (relatório DIÁRIO de obra), o tipo da
  /// coluna (`@db.Date`, sem hora) e a numeração por obra. Sem a constraint,
  /// dois toques no botão de criar produzem dois RDOs para a mesma data, e a
  /// segunda pessoa a preencher descobre isso quando o dia já passou.
  ///
  /// A exclusão de rascunho, que chegou depois, é DEFINITIVA justamente por
  /// causa desta constraint: ela não ignora `deletedAt`, então um soft delete
  /// deixaria a data ocupada e recriá-la daria 409 — anulando o único motivo
  /// de existir a exclusão, que é consertar uma data errada. A alternativa
  /// seria um índice parcial (`WHERE "deletedAt" IS NULL`) que o Prisma não
  /// expressa no schema, e que todo `migrate dev` seguinte tentaria trocar de
  /// volta pelo comum, derrubando esta garantia em silêncio. Ver
  /// `DailyReportsService.remove`.
  @@unique([constructionSiteId, reportDate])
  @@index([companyId])
  /// O índice comum que existia em `(constructionSiteId, reportDate)` saiu: o
  /// índice ÚNICO acima cobre exatamente as mesmas consultas ("os últimos
  /// relatórios das minhas obras"). Manter os dois só pagaria escrita dobrada.
  @@index([createdById])
  @@index([copiedFromId])
  @@index([submittedById])
}

/// Efetivo por função presente na obra no dia.
///
/// Uma linha por função, com a quantidade. NÃO existe coluna de total: o total
/// é a soma das linhas, e guardá-lo criaria dois números para a mesma verdade —
/// o segundo ficando errado no primeiro item editado. A tela também não deixa
/// digitar o total, pelo mesmo motivo.
model DailyReportLabor {
  id            String   @id @default(uuid()) @db.Uuid
  dailyReportId String   @db.Uuid
  /// Texto livre, e não um catálogo de funções. Em campo aparecem "Pedreiro",
  /// "Servente", mas também "Encarregado da empreiteira X" — travar num
  /// catálogo faria todo mundo lançar tudo em "Outros", que é pior que texto.
  role          String
  quantity      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  /// A mesma função duas vezes no mesmo dia é sempre engano: "Pedreiro 8" e
  /// "Pedreiro 3" deveriam ser "Pedreiro 11". A constraint transforma o engano
  /// em erro na hora, em vez de num total silenciosamente certo e numa lista
  /// confusa.
  @@unique([dailyReportId, role])
  @@index([dailyReportId])
}

/// Equipamento presente na obra no dia.
///
/// A lista é a do DIA, não a frota da empresa: um equipamento cadastrado no
/// ERP não está automaticamente nesta obra nesta data. Por isso o nome é texto
/// e não uma referência a um cadastro — não existe cadastro de equipamentos no
/// sistema, e inventar um aqui resolveria um problema que ninguém tem.
model DailyReportEquipment {
  id            String   @id @default(uuid()) @db.Uuid
  dailyReportId String   @db.Uuid
  name          String
  quantity      Int
  /// Situação do equipamento naquele dia ("em manutenção", "parado por falta
  /// de operador"). É o que torna legítimo o mesmo equipamento aparecer duas
  /// vezes — um operando, outro parado —, e por isso aqui NÃO há a constraint
  /// de unicidade que a mão de obra tem.
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  @@index([dailyReportId])
}

/// Serviço executado no dia.
model DailyReportActivity {
  id            String   @id @default(uuid()) @db.Uuid
  dailyReportId String   @db.Uuid
  description   String
  /// Onde na obra ("Pavimento 03", "Bloco B — fachada leste"). Opcional: numa
  /// obra pequena a localização é óbvia e exigi-la só atrasaria o registro.
  location      String?
  notes         String?
  /// Ordem de exibição. Preenchida na criação como "última da lista"; existe
  /// desde já para que reordenar seja depois um UPDATE de coluna, e não uma
  /// migration com backfill num RDO já assinado.
  position      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  @@index([dailyReportId, position])
}

/// Acontecimento relevante do dia — atraso de material, chuva, visita técnica,
/// paralisação.
model DailyReportOccurrence {
  id                String         @id @default(uuid()) @db.Uuid
  dailyReportId     String         @db.Uuid
  type              OccurrenceType
  description       String
  /// Hora do acontecimento, em minutos desde a meia-noite. Mesma escolha de
  /// `workStartMinutes`, e OPCIONAL: "chuva intensa durante a tarde" é um
  /// registro legítimo e não tem hora. Exigi-la faria o usuário inventar uma.
  occurredAtMinutes Int?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  @@index([dailyReportId])
}

/// Material movimentado na obra no dia.
///
/// **Não é estoque.** Não há saldo, entrada fiscal, fornecedor, custo,
/// almoxarifado nem inventário — esses conceitos pertencem a Compras e
/// Financeiro, que já os têm. Aqui a pergunta é uma só: "o que aconteceu com
/// os materiais na obra hoje?". Consultar o histórico de uma obra é percorrer
/// os RDOs dela; nenhum acumulado é mantido, e antecipar um seria criar uma
/// segunda verdade sobre o estoque que o ERP já modela em outro lugar.
///
/// Sem vínculo com `DailyReportActivity`, e de propósito: uma obra recebe
/// cimento sem que ninguém queira dizer a qual serviço ele pertence. Obrigar a
/// associação faria o usuário escolher uma atividade qualquer para conseguir
/// salvar.
model DailyReportMaterial {
  id            String               @id @default(uuid()) @db.Uuid
  dailyReportId String               @db.Uuid
  /// `name`, e não `materialName`: as irmãs desta tabela já chamam o campo de
  /// identificação de `name` (equipamento), `role` (função) e `description`
  /// (atividade). Repetir o nome do modelo dentro da coluna seria o único
  /// caso do schema.
  name          String
  /// `Decimal(12,3)` — o mesmo de `PurchaseRequestItem.quantity`. Decimal e
  /// não `Int` porque 2,5 m³ de concreto e 150,75 kg de vergalhão são as
  /// quantidades normais de uma obra; e não `Float` porque quantidade que
  /// entra em medição não pode carregar erro binário.
  quantity      Decimal              @db.Decimal(12, 3)
  unit          MaterialUnit
  movementType  MaterialMovementType
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  /// Sem unicidade por nome, ao contrário de `DailyReportLabor`: o mesmo
  /// material aparece legitimamente duas vezes no mesmo dia quando parte foi
  /// recebida e parte foi utilizada — são movimentações distintas, não engano.
  @@index([dailyReportId])
}

/// Foto ou vídeo anexado a um relatório diário.
///
/// **O binário NÃO fica aqui.** Esta tabela guarda só a referência
/// (`storageKey`) e os metadados; o arquivo vive no `StorageService`, que já
/// existia no ERP e já abstrai disco local e bucket S3. Não há segunda
/// infraestrutura de armazenamento para o Diário.
///
/// `storageKey` e não `fileUrl` (como em `Attachment`): aquele campo nasceu
/// guardando o caminho público `/uploads/...` porque o `FilesController`
/// localiza o anexo POR ele. Aqui a mídia é servida por uma rota própria do
/// Diário, que a encontra pelo id e checa o vínculo com a obra — a chave crua
/// é o que o storage precisa, e uma URL no banco só seria um caminho a mais
/// para manter em sincronia.
///
/// A linha só existe DEPOIS de o arquivo estar gravado no storage: não há
/// estado "pendente". É o que torna impossível um registro apontando para
/// arquivo que nunca chegou — ver `DailyReportMediaService.register`.
model DailyReportMedia {
  id              String               @id @default(uuid()) @db.Uuid
  dailyReportId   String               @db.Uuid
  type            DailyReportMediaType
  /// Caminho do objeto no storage, gerado pelo servidor
  /// (`diario/<empresa>/<obra>/<relatório>/<uuid>.<ext>`). Único: o mesmo
  /// objeto não pode ser registrado duas vezes, nem por retentativa.
  storageKey      String               @unique
  /// Miniatura da FOTO, quando existe. Objeto separado no storage: o original
  /// nunca é alterado nem substituído.
  ///
  /// Nulo para vídeo (não há miniatura gerada) e para qualquer foto enviada
  /// por um cliente que não a produziu — nesse caso a rota da miniatura serve
  /// o original, e a tela continua funcionando. É o que permite a coluna nascer
  /// sem backfill.
  thumbnailKey    String?              @unique
  /// Nome original do arquivo, guardado APENAS como metadado — nunca como
  /// chave de storage nem como parte de caminho. Nome vindo do cliente já foi
  /// vetor de path traversal em aplicação demais.
  fileName        String
  /// Tipo detectado pela ASSINATURA do arquivo, não o declarado pelo cliente.
  mimeType        String
  sizeBytes       Int
  /// Dimensões da imagem, lidas do cabeçalho do próprio arquivo no servidor.
  /// Nulas para vídeo, cujo contêiner exigiria um parser inteiro.
  width           Int?
  height          Int?
  /// Duração do vídeo em segundos, informada pelo navegador. É metadado de
  /// exibição, não controle de segurança: o cliente pode mentir, e mentir aqui
  /// só faz a tela mostrar um número errado.
  durationSeconds Int?
  createdById     String               @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id])

  @@index([dailyReportId])
  @@index([createdById])
}
