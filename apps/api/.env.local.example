# =============================================================================
# LOCAL — API (máquina do desenvolvedor)
# =============================================================================
# Copie para `.env.local` (gitignorado):
#
#   cp apps/api/.env.local.example apps/api/.env.local
#
# ATENÇÃO — dois arquivos, dois consumidores:
#
#   `npm run dev` (nest start --watch) carrega `.env`, não `.env.local`. É o
#   default do ConfigModule do Nest e não dá para passar `--env-file` por baixo
#   do `nest start`. Para o dia a dia, mantenha `.env` como cópia deste arquivo.
#
#   `.env.local` é usado pelos scripts que carregam o ambiente explicitamente
#   (`start:local`, `migrate:local`, `seed:local`, `db:status:local`).
#
# Banco: `docker compose -f docker/docker-compose.yml up -d` sobe o Postgres
# local na 5432.
# =============================================================================

NODE_ENV=development
PORT=3000

# Postgres local, sem TLS. `sslmode` não é exigido fora de produção — mas
# declarar `disable` deixa explícito e evita surpresa se NODE_ENV mudar.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eds?sslmode=disable"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/eds?sslmode=disable"

# O Vite roda na 5173. Sem proxy na frente, então TRUST_PROXY=0: com 1 sem proxy
# real, qualquer cliente forjaria o X-Forwarded-For e escaparia do rate limit.
CORS_ORIGIN="http://localhost:5173"
TRUST_PROXY=0

# Front chama a API direto (portas diferentes), então o cookie vive em /auth.
REFRESH_COOKIE_PATH="/auth"

# Segredos de desenvolvimento — não precisam ser fortes, precisam ter 32+ chars.
# NUNCA reaproveite estes valores em staging ou produção.
JWT_ACCESS_SECRET="dev-access-secret-com-no-minimo-32-caracteres"
JWT_REFRESH_SECRET="dev-refresh-secret-com-no-minimo-32-caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# `debug` mostra as queries e o ciclo de request; em local a saída é
# pretty-print (NODE_ENV != production).
LOG_LEVEL="debug"

# Massa de exemplo: empresa-vitrine, 6 papéis e 6 usuários com senha conhecida.
# Em local isso é conveniência; em qualquer ambiente publicado é falha grave.
SEED_DEMO=true

# Auto-cadastro. Ligue junto com VITE_PUBLIC_SIGNUP_ENABLED no web se for
# exercitar a tela `/cadastro`.
PUBLIC_SIGNUP_ENABLED=false

# Alternativa ao SEED_DEMO: criar só o admin, sem massa de exemplo.
# BOOTSTRAP_ADMIN_EMAIL="admin@local.test"
# BOOTSTRAP_ADMIN_PASSWORD="<escolha uma: 8-72 chars, letra e número>"

STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="uploads"
